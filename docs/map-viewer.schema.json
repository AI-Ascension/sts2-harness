{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.github.io/sts2-harness/schemas/ascension-map-viewer-v1.json",
  "title": "Consumer copy: proposed read-only map viewer presentation payload",
  "$comment": "This is a derived consumer copy for harness validation. The map viewer owns the authoritative viewer contract and must publish its own schema artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "snapshot_digest", "analysis_digest", "map", "aliases", "candidates", "historical", "complete", "available", "warnings"],
  "properties": {
    "schema": {"const": "ascension-map-viewer-v1"},
    "bundle_id": {"type": "string", "maxLength": 512, "description": "Empty for an unrendered artifact; the loader may inject the verified manifest digest in memory."},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "map": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "status", "nodes", "edges"],
      "properties": {
        "identity": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"type": "string", "minLength": 1, "maxLength": 128},
        "nodes": {
          "type": "array", "maxItems": 1024,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "floor", "lane", "category", "current", "legal", "reachable", "visited"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 512},
              "floor": {"type": "integer"},
              "lane": {"type": "integer"},
              "category": {"type": "string", "minLength": 1, "maxLength": 128},
              "current": {"type": "boolean"},
              "legal": {"type": "boolean"},
              "reachable": {"type": "boolean"},
              "visited": {"type": "boolean"}
            }
          }
        },
        "edges": {
          "type": "array", "maxItems": 8192,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["from", "to", "selected"],
            "properties": {
              "from": {"type": "string", "minLength": 1, "maxLength": 512},
              "to": {"type": "string", "minLength": 1, "maxLength": 512},
              "selected": {"type": "boolean"}
            }
          }
        }
      }
    },
    "aliases": {"type": "object", "propertyNames": {"minLength": 1, "maxLength": 512}, "maxProperties": 1024, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 512}},
    "candidates": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "nodes", "summary", "selection"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 512},
          "nodes": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
          "summary": {"type": "string", "minLength": 1, "maxLength": 512},
          "selection": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "historical": {"type": "boolean"},
    "complete": {"type": "boolean"},
    "available": {"type": "boolean"},
    "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 512}}
  }
}
