{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-harness/research/legal-action/1",
  "title": "STS2 semantic LegalAction",
  "description": "A state-derived action candidate with typed target domains and explicit settlement lifecycle.",
  "$comment": "This is a harness research record, not an MCP, gateway, protocol, or game-adapter contract. Raw coordinates and host object references are not representable.",
  "x-sts2-offline-provenance": { "offline_label_status": "privileged_offline_label", "storage": "separate_artifact", "policy_visible": false },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "identities", "observation_id", "state_id", "observation_generation", "build_profile", "action_type", "parameters", "target_domain", "preconditions", "mutability", "expected_successor_states", "settlement", "uncertainty", "provenance"],
  "properties": {
    "schema_version": { "const": "sts2-legal-action/1" },
    "action_id": { "$ref": "#/$defs/action_id" },
    "operation_id": { "$ref": "#/$defs/operation_id" },
    "identities": { "$ref": "#/$defs/identities" },
    "observation_id": { "$ref": "#/$defs/observation_id" },
    "state_id": { "$ref": "#/$defs/state_id" },
    "observation_generation": { "$ref": "#/$defs/generation" },
    "build_profile": { "$ref": "#/$defs/build_profile" },
    "action_type": { "$ref": "#/$defs/action_type" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "target_domain": { "$ref": "#/$defs/target_domain" },
    "preconditions": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/precondition" } },
    "mutability": { "$ref": "#/$defs/mutability" },
    "expected_successor_states": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/state_id" } },
    "settlement": { "$ref": "#/$defs/settlement" },
    "uncertainty": { "$ref": "#/$defs/uncertainty" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    { "if": { "properties": { "action_type": { "const": "COMBAT.PLAY_CARD" } } }, "then": { "properties": { "parameters": { "$ref": "#/$defs/play_card_parameters" } } } },
    { "if": { "properties": { "action_type": { "const": "COMBAT.USE_POTION" } } }, "then": { "properties": { "parameters": { "$ref": "#/$defs/use_potion_parameters" } } } },
    { "if": { "properties": { "action_type": { "const": "MAP.SELECT_NODE" } } }, "then": { "properties": { "parameters": { "$ref": "#/$defs/node_parameters" }, "target_domain": { "$ref": "#/$defs/map_target_domain" } } } },
    { "if": { "properties": { "action_type": { "const": "REWARD.SELECT_CARD" } } }, "then": { "properties": { "parameters": { "$ref": "#/$defs/choice_parameters" }, "target_domain": { "$ref": "#/$defs/choice_target_domain" } } } },
    { "if": { "properties": { "action_type": { "const": "SHOP.BUY" } } }, "then": { "properties": { "parameters": { "$ref": "#/$defs/shop_parameters" }, "target_domain": { "$ref": "#/$defs/shop_target_domain" } } } }
  ],
  "$defs": {
    "id_value": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "namespaced_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "type": "string", "pattern": "^sts2\\.[a-z_]+$" }, "value": { "$ref": "#/$defs/id_value" } } },
    "action_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.action" }, "value": { "$ref": "#/$defs/id_value" } } },
    "operation_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.operation" }, "value": { "$ref": "#/$defs/id_value" } } },
    "observation_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.observation" }, "value": { "$ref": "#/$defs/id_value" } } },
    "state_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.state" }, "value": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" } } },
    "instance_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.instance" }, "value": { "$ref": "#/$defs/id_value" } } },
    "session_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.session" }, "value": { "$ref": "#/$defs/id_value" } } },
    "run_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.run" }, "value": { "$ref": "#/$defs/id_value" } } },
    "episode_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.episode" }, "value": { "$ref": "#/$defs/id_value" } } },
    "trajectory_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.trajectory" }, "value": { "$ref": "#/$defs/id_value" } } },
    "trace_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.trace" }, "value": { "$ref": "#/$defs/id_value" } } },
    "identities": { "type": "object", "additionalProperties": false, "required": ["instance_id", "session_id", "run_id", "episode_id", "trajectory_id", "trace_id"], "properties": { "instance_id": { "$ref": "#/$defs/instance_id" }, "session_id": { "$ref": "#/$defs/session_id" }, "run_id": { "$ref": "#/$defs/run_id" }, "episode_id": { "$ref": "#/$defs/episode_id" }, "trajectory_id": { "$ref": "#/$defs/trajectory_id" }, "trace_id": { "$ref": "#/$defs/trace_id" } } },
    "hash": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "build_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["build_id", "semantic_version", "channel", "platform", "architecture", "profile_id", "profile_digest", "locale", "resolution", "ui_scale", "input_method", "active_mods", "run_modifiers"],
      "properties": {
        "build_id": { "$ref": "#/$defs/id_value" }, "semantic_version": { "type": ["string", "null"], "maxLength": 64 }, "channel": { "enum": ["public", "public-beta", "beta", "offline"] },
        "platform": { "type": ["string", "null"], "maxLength": 64 }, "architecture": { "type": ["string", "null"], "maxLength": 64 }, "profile_id": { "$ref": "#/$defs/id_value" }, "profile_digest": { "$ref": "#/$defs/hash" }, "locale": { "type": ["string", "null"], "maxLength": 32 },
        "resolution": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 }, "height": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 } } },
        "ui_scale": { "type": ["number", "null"], "minimum": 0.1, "maximum": 8 }, "input_method": { "enum": ["mouse_keyboard", "controller", "semantic", "unknown"] },
        "active_mods": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["mod_id", "version", "content_hash"], "properties": { "mod_id": { "$ref": "#/$defs/id_value" }, "version": { "type": "string", "maxLength": 64 }, "content_hash": { "$ref": "#/$defs/hash" } } } },
        "run_modifiers": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id_value" } }
      }
    },
    "action_type": { "enum": ["COMBAT.PLAY_CARD", "COMBAT.USE_POTION", "COMBAT.END_TURN", "COMBAT.SELECT_TARGET", "COMBAT.SELECT_CARDS", "COMBAT.CONFIRM_SELECTION", "MAP.SELECT_NODE", "COOP.VOTE_NODE", "REWARD.SELECT_CARD", "REWARD.SKIP_CARD", "REWARD.REPLACE_POTION", "SHOP.BUY", "SHOP.REMOVE_CARD", "EVENT.SELECT_OPTION", "REST.SELECT_OPTION", "SELECT.CHOOSE", "SELECT.CONFIRM", "UI.CANCEL", "SYS.WAIT", "SYS.REOBSERVE", "RECOVERY.RESYNC", "RUN.SAVE_QUIT"] },
    "parameters": { "oneOf": [ { "$ref": "#/$defs/no_parameters" }, { "$ref": "#/$defs/play_card_parameters" }, { "$ref": "#/$defs/use_potion_parameters" }, { "$ref": "#/$defs/target_parameters" }, { "$ref": "#/$defs/cards_parameters" }, { "$ref": "#/$defs/node_parameters" }, { "$ref": "#/$defs/choice_parameters" }, { "$ref": "#/$defs/shop_parameters" }, { "$ref": "#/$defs/replace_potion_parameters" } ] },
    "no_parameters": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "play_card_parameters": { "type": "object", "additionalProperties": false, "required": ["card_instance_id"], "properties": { "card_instance_id": { "$ref": "#/$defs/id_value" }, "target_id": { "$ref": "#/$defs/id_value" } } },
    "use_potion_parameters": { "type": "object", "additionalProperties": false, "required": ["potion_instance_id"], "properties": { "potion_instance_id": { "$ref": "#/$defs/id_value" }, "target_id": { "$ref": "#/$defs/id_value" } } },
    "target_parameters": { "type": "object", "additionalProperties": false, "required": ["target_id"], "properties": { "target_id": { "$ref": "#/$defs/id_value" } } },
    "cards_parameters": { "type": "object", "additionalProperties": false, "required": ["card_instance_ids"], "properties": { "card_instance_ids": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id_value" } } } },
    "node_parameters": { "type": "object", "additionalProperties": false, "required": ["node_id"], "properties": { "node_id": { "$ref": "#/$defs/id_value" } } },
    "choice_parameters": { "type": "object", "additionalProperties": false, "required": ["choice_id"], "properties": { "choice_id": { "$ref": "#/$defs/id_value" } } },
    "shop_parameters": { "type": "object", "additionalProperties": false, "required": ["item_id"], "properties": { "item_id": { "$ref": "#/$defs/id_value" } } },
    "replace_potion_parameters": { "type": "object", "additionalProperties": false, "required": ["reward_id", "discarded_potion_instance_id"], "properties": { "reward_id": { "$ref": "#/$defs/id_value" }, "discarded_potion_instance_id": { "$ref": "#/$defs/id_value" } } },
    "target_domain": { "type": "object", "additionalProperties": false, "required": ["type", "allowed_ids", "selection"], "properties": { "type": { "enum": ["none", "enemy", "ally", "card", "pile", "map_node", "choice", "shop_item", "potion", "object"] }, "allowed_ids": { "type": "array", "uniqueItems": true, "maxItems": 256, "items": { "$ref": "#/$defs/id_value" } }, "selection": { "enum": ["none", "exactly_one", "zero_or_one", "one_or_more", "bounded_set"] }, "minimum": { "type": "integer", "minimum": 0, "maximum": 256 }, "maximum": { "type": "integer", "minimum": 0, "maximum": 256 } } },
    "map_target_domain": { "allOf": [ { "$ref": "#/$defs/target_domain" }, { "type": "object", "properties": { "type": { "const": "map_node" } } } ], "unevaluatedProperties": false },
    "choice_target_domain": { "allOf": [ { "$ref": "#/$defs/target_domain" }, { "type": "object", "properties": { "type": { "const": "choice" } } } ], "unevaluatedProperties": false },
    "shop_target_domain": { "allOf": [ { "$ref": "#/$defs/target_domain" }, { "type": "object", "properties": { "type": { "const": "shop_item" } } } ], "unevaluatedProperties": false },
    "precondition": { "type": "object", "additionalProperties": false, "required": ["code", "satisfied", "checked_generation"], "properties": { "code": { "enum": ["input_enabled", "state_matches", "observation_current", "instance_present", "card_playable", "resource_affordable", "target_valid", "selection_complete", "capacity_available", "patch_validated", "network_synchronized", "other"] }, "satisfied": { "type": "boolean" }, "checked_generation": { "$ref": "#/$defs/generation" }, "failure_reason": { "enum": ["not_checked", "missing_observation", "stale", "invalid", "insufficient_resource", "unknown"] } } },
    "mutability": { "type": "object", "additionalProperties": false, "required": ["mutates_state", "reversible", "confirmation_required", "at_most_once"], "properties": { "mutates_state": { "type": "boolean" }, "reversible": { "type": "boolean" }, "confirmation_required": { "type": "boolean" }, "at_most_once": { "const": true } } },
    "settlement": { "type": "object", "additionalProperties": false, "required": ["status", "attempt", "dispatch_count", "reconciliation_required"], "properties": { "status": { "enum": ["proposed", "admitted", "dispatched", "accepted", "settling", "settled", "rejected", "cancelled", "unknown", "reconciled"] }, "operation_id": { "$ref": "#/$defs/operation_id" }, "attempt": { "type": "integer", "minimum": 0, "maximum": 8 }, "dispatch_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "reconciliation_required": { "type": "boolean" }, "settled_generation": { "$ref": "#/$defs/generation" }, "reason": { "enum": ["stale_observation", "invalid_action", "timeout", "cancelled_by_operator", "patch_quarantine", "network_interruption", "unknown_effect", "other"] }, "reconciled_from": { "enum": ["unknown", "accepted", "settling"] } } },
    "uncertainty": { "type": "object", "additionalProperties": false, "required": ["status", "items"], "properties": { "status": { "enum": ["known", "low", "medium", "high", "unknown"] }, "items": { "type": "array", "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["metric_id", "confidence", "source"], "properties": { "metric_id": { "enum": ["legality", "target_domain", "settlement", "successor_state", "other"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "enum": ["visible", "on_demand", "history", "calculation", "estimate", "unknown"] } } } } } },
    "evidence_status": { "enum": ["confirmed", "source-derived", "inferred", "proposed", "unverified", "unsupported"] },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["source_kind", "evidence_status", "epistemic_status", "source_ids", "captured_at", "confidence", "independent_verification", "policy_visible"], "properties": { "source_kind": { "enum": ["controlled_live_capture", "replay_reduction", "synthetic", "expert_demonstration", "simulator_generated"] }, "evidence_status": { "$ref": "#/$defs/evidence_status" }, "epistemic_status": { "enum": ["observed", "documented", "extracted", "calculated", "inferred", "hypothesized"] }, "source_ids": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id_value" } }, "captured_at": { "$ref": "#/$defs/timestamp" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "independent_verification": { "type": "boolean" }, "policy_visible": { "const": true } } },
    "offline_privileged_label": { "description": "Offline-only label, intentionally unreachable from the production root.", "type": "object", "additionalProperties": false, "required": ["status", "artifact_id", "policy_visible"], "properties": { "status": { "const": "privileged_offline_label" }, "artifact_id": { "$ref": "#/$defs/id_value" }, "policy_visible": { "const": false } } }
  }
}
