{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-harness/research/state-transition/1",
  "title": "STS2 StateTransition",
  "description": "A build-bound transition record separating dispatch, settlement, postcondition evidence, and recovery.",
  "$comment": "Accepted is not settled. A possible mutation followed by a timeout requires read-only reconciliation before any retry.",
  "x-sts2-offline-provenance": { "offline_label_status": "privileged_offline_label", "storage": "separate_artifact", "policy_visible": false },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "identities", "operation_id", "build_profile", "source_state", "source_observation", "action", "expected_successor_states", "settlement", "actual_target_state", "target_observation", "timing", "success_evidence", "failure_evidence", "recovery", "uncertainty", "provenance"],
  "properties": {
    "schema_version": { "const": "sts2-state-transition/1" },
    "transition_id": { "$ref": "#/$defs/transition_id" },
    "identities": { "$ref": "#/$defs/identities" },
    "operation_id": { "$ref": "#/$defs/operation_id" },
    "build_profile": { "$ref": "#/$defs/build_profile" },
    "source_state": { "$ref": "#/$defs/state_id" },
    "source_observation": { "$ref": "#/$defs/observation_ref" },
    "action": { "$ref": "#/$defs/action_summary" },
    "expected_successor_states": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/state_id" } },
    "settlement": { "$ref": "#/$defs/settlement" },
    "actual_target_state": { "anyOf": [ { "$ref": "#/$defs/state_id" }, { "type": "null" } ] },
    "target_observation": { "anyOf": [ { "$ref": "#/$defs/observation_ref" }, { "type": "null" } ] },
    "timing": { "$ref": "#/$defs/timing" },
    "success_evidence": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } },
    "failure_evidence": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } },
    "recovery": { "$ref": "#/$defs/recovery" },
    "uncertainty": { "$ref": "#/$defs/uncertainty" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    { "if": { "properties": { "settlement": { "properties": { "status": { "const": "settled" } } } } }, "then": { "required": ["actual_target_state", "target_observation"], "properties": { "actual_target_state": { "$ref": "#/$defs/state_id" }, "target_observation": { "$ref": "#/$defs/observation_ref" }, "success_evidence": { "minItems": 1 } } } },
    { "if": { "properties": { "settlement": { "properties": { "status": { "const": "unknown" } } } } }, "then": { "properties": { "actual_target_state": { "type": "null" }, "target_observation": { "type": "null" }, "recovery": { "properties": { "mode": { "const": "reconcile" }, "required": { "const": true } } } } } },
    { "if": { "properties": { "settlement": { "properties": { "status": { "const": "reconciled" } } } } }, "then": { "required": ["target_observation", "actual_target_state"], "properties": { "target_observation": { "$ref": "#/$defs/observation_ref" }, "actual_target_state": { "$ref": "#/$defs/state_id" }, "recovery": { "properties": { "mode": { "const": "reconcile" } } } } } }
  ],
  "$defs": {
    "id_value": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "transition_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.transition" }, "value": { "$ref": "#/$defs/id_value" } } },
    "operation_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.operation" }, "value": { "$ref": "#/$defs/id_value" } } },
    "observation_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.observation" }, "value": { "$ref": "#/$defs/id_value" } } },
    "instance_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.instance" }, "value": { "$ref": "#/$defs/id_value" } } },
    "session_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.session" }, "value": { "$ref": "#/$defs/id_value" } } },
    "run_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.run" }, "value": { "$ref": "#/$defs/id_value" } } },
    "episode_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.episode" }, "value": { "$ref": "#/$defs/id_value" } } },
    "trajectory_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.trajectory" }, "value": { "$ref": "#/$defs/id_value" } } },
    "trace_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.trace" }, "value": { "$ref": "#/$defs/id_value" } } },
    "identities": { "type": "object", "additionalProperties": false, "required": ["instance_id", "session_id", "run_id", "episode_id", "trajectory_id", "trace_id"], "properties": { "instance_id": { "$ref": "#/$defs/instance_id" }, "session_id": { "$ref": "#/$defs/session_id" }, "run_id": { "$ref": "#/$defs/run_id" }, "episode_id": { "$ref": "#/$defs/episode_id" }, "trajectory_id": { "$ref": "#/$defs/trajectory_id" }, "trace_id": { "$ref": "#/$defs/trace_id" } } },
    "state_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.state" }, "value": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" } } },
    "action_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.action" }, "value": { "$ref": "#/$defs/id_value" } } },
    "action_type": { "enum": ["COMBAT.PLAY_CARD", "COMBAT.USE_POTION", "COMBAT.END_TURN", "COMBAT.SELECT_TARGET", "COMBAT.SELECT_CARDS", "COMBAT.CONFIRM_SELECTION", "MAP.SELECT_NODE", "COOP.VOTE_NODE", "REWARD.SELECT_CARD", "REWARD.SKIP_CARD", "REWARD.REPLACE_POTION", "SHOP.BUY", "SHOP.REMOVE_CARD", "EVENT.SELECT_OPTION", "REST.SELECT_OPTION", "SELECT.CHOOSE", "SELECT.CONFIRM", "UI.CANCEL", "SYS.WAIT", "SYS.REOBSERVE", "RECOVERY.RESYNC", "RUN.SAVE_QUIT"] },
    "target_domain": { "type": "object", "additionalProperties": false, "required": ["type", "allowed_ids", "selection"], "properties": { "type": { "enum": ["none", "enemy", "ally", "card", "pile", "map_node", "choice", "shop_item", "potion", "object"] }, "allowed_ids": { "type": "array", "uniqueItems": true, "maxItems": 256, "items": { "$ref": "#/$defs/id_value" } }, "selection": { "enum": ["none", "exactly_one", "zero_or_one", "one_or_more", "bounded_set"] } } },
    "action_summary": { "type": "object", "additionalProperties": false, "required": ["action_id", "action_type", "target_domain"], "properties": { "action_id": { "$ref": "#/$defs/action_id" }, "action_type": { "$ref": "#/$defs/action_type" }, "target_domain": { "$ref": "#/$defs/target_domain" } } },
    "observation_ref": { "type": "object", "additionalProperties": false, "required": ["observation_id", "generation", "freshness"], "properties": { "observation_id": { "$ref": "#/$defs/observation_id" }, "generation": { "$ref": "#/$defs/generation" }, "freshness": { "enum": ["fresh", "stale", "unknown", "contradictory"] } } },
    "settlement": { "type": "object", "additionalProperties": false, "required": ["status", "dispatch_count", "reconciliation_required"], "properties": { "status": { "enum": ["proposed", "admitted", "dispatched", "accepted", "settling", "settled", "rejected", "cancelled", "unknown", "reconciled"] }, "dispatch_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "reconciliation_required": { "type": "boolean" }, "accepted_at": { "$ref": "#/$defs/timestamp" }, "settled_at": { "$ref": "#/$defs/timestamp" }, "reason": { "enum": ["stale_observation", "invalid_action", "timeout", "cancelled_by_operator", "patch_quarantine", "network_interruption", "unknown_effect", "other"] } } },
    "timing": { "type": "object", "additionalProperties": false, "required": ["recorded_at", "latency_ms", "deadline_ms"], "properties": { "recorded_at": { "$ref": "#/$defs/timestamp" }, "latency_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 3600000 }, "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["code", "generation", "evidence_status"], "properties": { "code": { "enum": ["fresh_successor_state", "resource_consumed", "source_collection_changed", "modal_changed", "same_state_postcondition", "rejection_reason", "reconciliation_read", "safe_halt", "none"] }, "generation": { "$ref": "#/$defs/generation" }, "evidence_status": { "enum": ["confirmed", "source-derived", "inferred", "proposed", "unverified", "unsupported"] } } },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["mode", "required", "attempts"], "properties": { "mode": { "enum": ["none", "reobserve", "reconcile", "retry_once", "cancel", "safe_halt"] }, "required": { "type": "boolean" }, "attempts": { "type": "integer", "minimum": 0, "maximum": 1 }, "reason": { "enum": ["stale_observation", "generation_mismatch", "hidden_modal", "failed_input", "possible_mutation", "state_disagreement", "patch_quarantine", "unknown_state", "other"] } } },
    "uncertainty": { "type": "object", "additionalProperties": false, "required": ["status", "confidence", "source"], "properties": { "status": { "enum": ["known", "low", "medium", "high", "unknown"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "enum": ["visible", "on_demand", "history", "calculation", "estimate", "reconciliation", "unknown"] } } },
    "build_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["build_id", "semantic_version", "channel", "platform", "architecture", "profile_id", "profile_digest", "locale", "resolution", "ui_scale", "input_method", "active_mods", "run_modifiers"],
      "properties": {
        "build_id": { "$ref": "#/$defs/id_value" }, "semantic_version": { "type": ["string", "null"], "maxLength": 64 }, "channel": { "enum": ["public", "public-beta", "beta", "offline"] }, "platform": { "type": ["string", "null"], "maxLength": 64 }, "architecture": { "type": ["string", "null"], "maxLength": 64 }, "profile_id": { "$ref": "#/$defs/id_value" }, "profile_digest": { "$ref": "#/$defs/hash" }, "locale": { "type": ["string", "null"], "maxLength": 32 },
        "resolution": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 }, "height": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 } } },
        "ui_scale": { "type": ["number", "null"], "minimum": 0.1, "maximum": 8 }, "input_method": { "enum": ["mouse_keyboard", "controller", "semantic", "unknown"] }, "active_mods": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["mod_id", "version", "content_hash"], "properties": { "mod_id": { "$ref": "#/$defs/id_value" }, "version": { "type": "string", "maxLength": 64 }, "content_hash": { "$ref": "#/$defs/hash" } } } }, "run_modifiers": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id_value" } }
      }
    },
    "hash": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["source_kind", "evidence_status", "epistemic_status", "source_ids", "captured_at", "confidence", "independent_verification", "policy_visible"], "properties": { "source_kind": { "enum": ["controlled_live_capture", "replay_reduction", "synthetic", "expert_demonstration", "simulator_generated"] }, "evidence_status": { "enum": ["confirmed", "source-derived", "inferred", "proposed", "unverified", "unsupported"] }, "epistemic_status": { "enum": ["observed", "documented", "extracted", "calculated", "inferred", "hypothesized"] }, "source_ids": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id_value" } }, "captured_at": { "$ref": "#/$defs/timestamp" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "independent_verification": { "type": "boolean" }, "policy_visible": { "const": true } } },
    "offline_privileged_label": { "description": "Offline-only label, intentionally unreachable from the production root.", "type": "object", "additionalProperties": false, "required": ["status", "artifact_id", "policy_visible"], "properties": { "status": { "const": "privileged_offline_label" }, "artifact_id": { "$ref": "#/$defs/id_value" }, "policy_visible": { "const": false } } }
  }
}
