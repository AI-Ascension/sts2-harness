{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-harness/research/decision-record/1",
  "title": "STS2 auditable DecisionRecord",
  "description": "A bounded decision audit containing named facts and estimates, not private chain-of-thought.",
  "$comment": "This harness-owned research record is not a game, MCP, gateway, or provider contract. Accepted action status is not proof of game effect.",
  "x-sts2-offline-provenance": { "offline_label_status": "privileged_offline_label", "storage": "separate_artifact", "policy_visible": false },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "identities", "observation_id", "observation_generation", "build_profile", "freshness", "objective", "legal_candidates", "hard_eliminations", "calculations", "estimates", "candidate_scores", "selected_action", "rationale", "settlement", "expected_transition", "actual_transition", "outcome", "policy_provenance", "provenance"],
  "properties": {
    "schema_version": { "const": "sts2-decision-record/1" },
    "decision_id": { "$ref": "#/$defs/decision_id" },
    "identities": { "$ref": "#/$defs/identities" },
    "observation_id": { "$ref": "#/$defs/observation_id" },
    "observation_generation": { "$ref": "#/$defs/generation" },
    "build_profile": { "$ref": "#/$defs/build_profile" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "objective": { "$ref": "#/$defs/objective" },
    "legal_candidates": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/candidate" } },
    "hard_eliminations": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/elimination" } },
    "calculations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/calculation" } },
    "estimates": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/estimate" } },
    "candidate_scores": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/candidate_score" } },
    "selected_action": { "$ref": "#/$defs/action_summary" },
    "rationale": { "$ref": "#/$defs/rationale" },
    "settlement": { "$ref": "#/$defs/settlement" },
    "expected_transition": { "$ref": "#/$defs/transition_summary" },
    "actual_transition": { "anyOf": [ { "$ref": "#/$defs/transition_summary" }, { "type": "null" } ] },
    "outcome": { "$ref": "#/$defs/outcome" },
    "policy_provenance": { "$ref": "#/$defs/policy_provenance" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "id_value": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "decision_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.decision" }, "value": { "$ref": "#/$defs/id_value" } } },
    "observation_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.observation" }, "value": { "$ref": "#/$defs/id_value" } } },
    "model_execution_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.model_execution" }, "value": { "$ref": "#/$defs/id_value" } } },
    "instance_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.instance" }, "value": { "$ref": "#/$defs/id_value" } } },
    "session_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.session" }, "value": { "$ref": "#/$defs/id_value" } } },
    "run_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.run" }, "value": { "$ref": "#/$defs/id_value" } } },
    "episode_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.episode" }, "value": { "$ref": "#/$defs/id_value" } } },
    "trajectory_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.trajectory" }, "value": { "$ref": "#/$defs/id_value" } } },
    "trace_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.trace" }, "value": { "$ref": "#/$defs/id_value" } } },
    "identities": { "type": "object", "additionalProperties": false, "required": ["instance_id", "session_id", "run_id", "episode_id", "trajectory_id", "trace_id"], "properties": { "instance_id": { "$ref": "#/$defs/instance_id" }, "session_id": { "$ref": "#/$defs/session_id" }, "run_id": { "$ref": "#/$defs/run_id" }, "episode_id": { "$ref": "#/$defs/episode_id" }, "trajectory_id": { "$ref": "#/$defs/trajectory_id" }, "trace_id": { "$ref": "#/$defs/trace_id" } } },
    "hash": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "build_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["build_id", "semantic_version", "channel", "platform", "architecture", "profile_id", "profile_digest", "locale", "resolution", "ui_scale", "input_method", "active_mods", "run_modifiers"],
      "properties": {
        "build_id": { "$ref": "#/$defs/id_value" }, "semantic_version": { "type": ["string", "null"], "maxLength": 64 }, "channel": { "enum": ["public", "public-beta", "beta", "offline"] }, "platform": { "type": ["string", "null"], "maxLength": 64 }, "architecture": { "type": ["string", "null"], "maxLength": 64 }, "profile_id": { "$ref": "#/$defs/id_value" }, "profile_digest": { "$ref": "#/$defs/hash" }, "locale": { "type": ["string", "null"], "maxLength": 32 },
        "resolution": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 }, "height": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 } } },
        "ui_scale": { "type": ["number", "null"], "minimum": 0.1, "maximum": 8 }, "input_method": { "enum": ["mouse_keyboard", "controller", "semantic", "unknown"] },
        "active_mods": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["mod_id", "version", "content_hash"], "properties": { "mod_id": { "$ref": "#/$defs/id_value" }, "version": { "type": "string", "maxLength": 64 }, "content_hash": { "$ref": "#/$defs/hash" } } } },
        "run_modifiers": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id_value" } }
      }
    },
    "state_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.state" }, "value": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" } } },
    "action_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.action" }, "value": { "$ref": "#/$defs/id_value" } } },
    "action_type": { "enum": ["COMBAT.PLAY_CARD", "COMBAT.USE_POTION", "COMBAT.END_TURN", "COMBAT.SELECT_TARGET", "COMBAT.SELECT_CARDS", "COMBAT.CONFIRM_SELECTION", "MAP.SELECT_NODE", "COOP.VOTE_NODE", "REWARD.SELECT_CARD", "REWARD.SKIP_CARD", "REWARD.REPLACE_POTION", "SHOP.BUY", "SHOP.REMOVE_CARD", "EVENT.SELECT_OPTION", "REST.SELECT_OPTION", "SELECT.CHOOSE", "SELECT.CONFIRM", "UI.CANCEL", "SYS.WAIT", "SYS.REOBSERVE", "RECOVERY.RESYNC", "RUN.SAVE_QUIT"] },
    "target_domain": { "type": "object", "additionalProperties": false, "required": ["type", "allowed_ids", "selection"], "properties": { "type": { "enum": ["none", "enemy", "ally", "card", "pile", "map_node", "choice", "shop_item", "potion", "object"] }, "allowed_ids": { "type": "array", "uniqueItems": true, "maxItems": 256, "items": { "$ref": "#/$defs/id_value" } }, "selection": { "enum": ["none", "exactly_one", "zero_or_one", "one_or_more", "bounded_set"] } } },
    "action_summary": { "type": "object", "additionalProperties": false, "required": ["action_id", "action_type", "target_domain"], "properties": { "action_id": { "$ref": "#/$defs/action_id" }, "action_type": { "$ref": "#/$defs/action_type" }, "target_domain": { "$ref": "#/$defs/target_domain" }, "consideration": { "enum": ["eligible", "dominated", "risky", "eliminated", "preferred", "unknown"] } } },
    "candidate": { "allOf": [ { "$ref": "#/$defs/action_summary" }, { "type": "object", "required": ["consideration"], "properties": { "consideration": { "enum": ["eligible", "dominated", "risky", "eliminated", "preferred", "unknown"] } } } ], "unevaluatedProperties": false },
    "elimination": { "type": "object", "additionalProperties": false, "required": ["action_id", "reason_code", "fact_ids"], "properties": { "action_id": { "$ref": "#/$defs/action_id" }, "reason_code": { "enum": ["illegal", "stale", "insufficient_resource", "invalid_target", "guaranteed_death", "patch_quarantine", "dominated", "unknown"] }, "fact_ids": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id_value" } } } },
    "calculation": { "type": "object", "additionalProperties": false, "required": ["calculation_id", "result", "dependency_field_ids", "status"], "properties": { "calculation_id": { "enum": ["incoming_damage", "survival_margin", "guaranteed_lethal", "affordability", "reachability", "draw_probability", "route_utility", "other"] }, "result": { "oneOf": [ { "type": "boolean" }, { "type": "number", "minimum": -1e15, "maximum": 1e15 }, { "type": "string", "maxLength": 256 } ] }, "dependency_field_ids": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "$ref": "#/$defs/id_value" } }, "status": { "const": "calculated" } } },
    "uncertainty": { "type": "object", "additionalProperties": false, "required": ["status", "confidence", "source"], "properties": { "status": { "enum": ["known", "low", "medium", "high", "unknown"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "enum": ["visible", "on_demand", "history", "calculation", "estimate", "reconciliation", "unknown"] }, "lower": { "type": "number", "minimum": -1e15, "maximum": 1e15 }, "upper": { "type": "number", "minimum": -1e15, "maximum": 1e15 } } },
    "estimate": { "type": "object", "additionalProperties": false, "required": ["estimate_id", "value", "uncertainty", "dependency_field_ids"], "properties": { "estimate_id": { "enum": ["next_turn_function_probability", "future_enemy_behavior", "expected_hp_loss", "route_survival_probability", "boss_ready_probability", "potion_future_value", "other"] }, "value": { "type": "number", "minimum": -1e15, "maximum": 1e15 }, "uncertainty": { "$ref": "#/$defs/uncertainty" }, "dependency_field_ids": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id_value" } } } },
    "candidate_score": { "type": "object", "additionalProperties": false, "required": ["action_id", "total", "components", "uncertainty"], "properties": { "action_id": { "$ref": "#/$defs/action_id" }, "total": { "type": "number", "minimum": -1e15, "maximum": 1e15 }, "components": { "type": "object", "additionalProperties": false, "required": ["tactical", "survival", "future_value", "risk"], "properties": { "tactical": { "type": "number", "minimum": -1e15, "maximum": 1e15 }, "survival": { "type": "number", "minimum": -1e15, "maximum": 1e15 }, "future_value": { "type": "number", "minimum": -1e15, "maximum": 1e15 }, "risk": { "type": "number", "minimum": -1e15, "maximum": 1e15 } } }, "uncertainty": { "$ref": "#/$defs/uncertainty" } } },
    "rationale": { "type": "object", "additionalProperties": false, "required": ["objective", "fact_ids", "text"], "properties": { "objective": { "type": "string", "maxLength": 256 }, "fact_ids": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id_value" } }, "text": { "type": "string", "minLength": 1, "maxLength": 512 } } },
    "objective": { "type": "object", "additionalProperties": false, "required": ["primary", "hard_constraints"], "properties": { "primary": { "enum": ["guaranteed_lethal", "survive_current_turn", "maximize_run_value", "route_survival", "take_reward", "resolve_recovery", "other"] }, "hard_constraints": { "type": "array", "maxItems": 32, "items": { "enum": ["no_guaranteed_death", "no_illegal_action", "preserve_patch_safety", "preserve_potion", "preserve_gold", "preserve_flexibility", "other"] } } } },
    "settlement": { "type": "object", "additionalProperties": false, "required": ["status", "dispatch_count", "reconciliation_required"], "properties": { "status": { "enum": ["proposed", "admitted", "dispatched", "accepted", "settling", "settled", "rejected", "cancelled", "unknown", "reconciled"] }, "operation_id": { "type": "object", "additionalProperties": false, "required": ["namespace", "value"], "properties": { "namespace": { "const": "sts2.operation" }, "value": { "$ref": "#/$defs/id_value" } } }, "dispatch_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "reconciliation_required": { "type": "boolean" }, "settled_generation": { "$ref": "#/$defs/generation" }, "reason": { "enum": ["stale_observation", "invalid_action", "timeout", "cancelled_by_operator", "patch_quarantine", "network_interruption", "unknown_effect", "other"] } } },
    "transition_summary": { "type": "object", "additionalProperties": false, "required": ["source_state", "expected_state_ids", "actual_state_id", "observation_generation", "evidence"], "properties": { "source_state": { "$ref": "#/$defs/state_id" }, "expected_state_ids": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/state_id" } }, "actual_state_id": { "anyOf": [ { "$ref": "#/$defs/state_id" }, { "type": "null" } ] }, "observation_generation": { "$ref": "#/$defs/generation" }, "evidence": { "type": "array", "maxItems": 32, "items": { "enum": ["fresh_state", "resource_consumed", "modal_changed", "source_collection_changed", "same_state_postcondition", "none"] } } } },
    "freshness": { "type": "object", "additionalProperties": false, "required": ["status", "source_generation", "stable_snapshot", "stale_field_ids"], "properties": { "status": { "enum": ["fresh", "stale", "unknown", "contradictory"] }, "source_generation": { "$ref": "#/$defs/generation" }, "stable_snapshot": { "type": "boolean" }, "stale_field_ids": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id_value" } } } },
    "outcome": { "type": "object", "additionalProperties": false, "required": ["status", "effect_observed", "evaluation_status"], "properties": { "status": { "enum": ["not_attempted", "settled", "rejected", "cancelled", "unknown", "reconciled"] }, "effect_observed": { "type": "boolean" }, "evaluation_status": { "enum": ["not_evaluated", "confirmed", "source-derived", "unverified"] } } },
    "policy_provenance": { "type": "object", "additionalProperties": false, "required": ["policy_model_version", "model_execution_id", "decision_timestamp"], "properties": { "policy_model_version": { "$ref": "#/$defs/id_value" }, "model_execution_id": { "$ref": "#/$defs/model_execution_id" }, "decision_timestamp": { "$ref": "#/$defs/timestamp" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["source_kind", "evidence_status", "epistemic_status", "source_ids", "captured_at", "confidence", "independent_verification", "policy_visible"], "properties": { "source_kind": { "enum": ["controlled_live_capture", "replay_reduction", "synthetic", "expert_demonstration", "simulator_generated"] }, "evidence_status": { "enum": ["confirmed", "source-derived", "inferred", "proposed", "unverified", "unsupported"] }, "epistemic_status": { "enum": ["observed", "documented", "extracted", "calculated", "inferred", "hypothesized"] }, "source_ids": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id_value" } }, "captured_at": { "$ref": "#/$defs/timestamp" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "independent_verification": { "type": "boolean" }, "policy_visible": { "const": true } } },
    "offline_privileged_label": { "description": "Offline-only label, intentionally unreachable from the production decision root.", "type": "object", "additionalProperties": false, "required": ["status", "artifact_id", "policy_visible"], "properties": { "status": { "const": "privileged_offline_label" }, "artifact_id": { "$ref": "#/$defs/id_value" }, "policy_visible": { "const": false } } }
  }
}
