{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:harness:inference-profile-catalog:v1",
  "title": "Harness inference-profile catalog",
  "description": "Owner-served, credential-free catalog of decision/analysis/planner configuration identities. A descriptor names one exact owner-resolved revision by profile_id/version/digest and publishes only bounded metadata: adapter, declared and observed model identity, prompt and settings revisions, supported settings and operations, context compatibility, continuity, effective budgets, grants and availability. Credentials, executables, URLs, prompt bytes and tool authority never appear here; they stay behind the owner that serves the provider.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ascension.inference-profiles/v1"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "owner_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "descriptors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/descriptor"
      }
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "owner_version",
    "catalog_digest",
    "descriptors"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ascension.inference-profile/v1"
        },
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter": {
          "$ref": "#/$defs/identifier"
        },
        "requested_model": {
          "$ref": "#/$defs/identifier"
        },
        "resolved_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "prompt_revision": {
          "$ref": "#/$defs/identifier"
        },
        "settings_revision": {
          "$ref": "#/$defs/identifier"
        },
        "supported_settings": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "operations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "node_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "context_compatibility": {
          "description": "Context references this profile accepts. Empty means unconstrained.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "continuity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider_session_continuity": {
              "type": "boolean"
            },
            "survives_controller_restart": {
              "type": "boolean"
            }
          },
          "required": [
            "provider_session_continuity",
            "survives_controller_restart"
          ]
        },
        "effective_budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_input_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "max_provider_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "max_input_bytes",
            "max_output_tokens",
            "max_provider_calls"
          ]
        },
        "grants": {
          "description": "Selection and edit are separate permissions; edit is published so a consumer can render a capability-driven unavailable state.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "select": {
              "type": "boolean"
            },
            "edit": {
              "type": "boolean"
            }
          },
          "required": [
            "select",
            "edit"
          ]
        },
        "state": {
          "enum": [
            "available",
            "disabled",
            "revoked",
            "stale",
            "unsupported"
          ]
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "version",
        "digest",
        "adapter",
        "requested_model",
        "resolved_model",
        "prompt_revision",
        "settings_revision",
        "supported_settings",
        "operations",
        "node_kinds",
        "context_compatibility",
        "continuity",
        "effective_budgets",
        "grants",
        "state"
      ]
    }
  }
}
