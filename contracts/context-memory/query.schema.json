{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-memory:query:v1",
  "title": "Proposed Phase 3 query contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-memory.query.v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "cutoff": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "corpus_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ranker_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "effect_class": {
      "const": "local_read_no_inference"
    }
  },
  "required": [
    "schema",
    "scope",
    "branch_id",
    "query",
    "cutoff",
    "corpus_generation",
    "ranker_version",
    "limit",
    "max_candidates",
    "effect_class"
  ]
}
