{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-memory:selection:v1",
  "title": "Proposed Phase 3 selection contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-memory.selection.v1"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cutoff": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "corpus_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selected_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "entry_id",
          "version",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "pinned_entry_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "protected_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "optional_byte_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "optional_rendered_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "whole_rendered_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prepared_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "whole_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "token_measurement": {
      "enum": [
        "exact_local",
        "estimate",
        "unavailable"
      ]
    },
    "budget_status": {
      "enum": [
        "within_local_limit",
        "bounded_unknown_total",
        "exceeded"
      ]
    },
    "rendered_content_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "phase2_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "effect_class": {
      "const": "local_preparation_only"
    }
  },
  "required": [
    "schema",
    "selection_id",
    "scope",
    "branch_id",
    "policy_id",
    "policy_version",
    "cutoff",
    "corpus_generation",
    "revocation_epoch",
    "selected_sources",
    "pinned_entry_ids",
    "protected_manifest_sha256",
    "optional_byte_budget",
    "optional_rendered_bytes",
    "whole_rendered_bytes",
    "prepared_manifest_sha256",
    "whole_tokens",
    "token_measurement",
    "budget_status",
    "rendered_content_ref",
    "expires_at",
    "phase2_revision_id",
    "effect_class"
  ]
}
