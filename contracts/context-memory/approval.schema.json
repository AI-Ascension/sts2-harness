{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-memory:approval:v1",
  "title": "Proposed Phase 3 approval contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-memory.approval.v1"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "selection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "phase2_preview_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "phase2_prepared_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "planned_phase2_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "preview_ready",
        "committed_held",
        "stale"
      ]
    },
    "commit_auto_resumes": {
      "const": false
    },
    "summary_inference_calls": {
      "const": 0
    },
    "gameplay_inference_calls": {
      "const": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "approval_id",
    "scope",
    "selection_id",
    "selection_sha256",
    "policy_id",
    "policy_version",
    "phase2_preview_id",
    "phase2_prepared_manifest_sha256",
    "planned_phase2_revision_id",
    "source_manifest_sha256",
    "revocation_epoch",
    "state",
    "commit_auto_resumes",
    "summary_inference_calls",
    "gameplay_inference_calls",
    "expires_at"
  ]
}
