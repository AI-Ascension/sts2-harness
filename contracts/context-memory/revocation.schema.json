{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-memory:revocation:v1",
  "title": "Proposed Phase 3 revocation contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-memory.revocation.v1"
    },
    "revocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "entry_id",
          "version",
          "sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "denial_committed": {
      "const": true
    },
    "cleanup_status": {
      "enum": [
        "pending",
        "running",
        "complete",
        "blocked"
      ]
    },
    "affected_derivatives": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "historical_manifests_rewritten": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "revocation_id",
    "scope",
    "roots",
    "revocation_epoch",
    "denial_committed",
    "cleanup_status",
    "affected_derivatives",
    "historical_manifests_rewritten",
    "created_at"
  ]
}
