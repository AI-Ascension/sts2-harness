{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-memory:entry:v1",
  "title": "Proposed Phase 3 entry contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-memory.entry.v1"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {
      "enum": [
        "historical_observation",
        "settled_action",
        "unresolved_marker",
        "operator_note",
        "static_reference",
        "map_bundle",
        "extract",
        "summary"
      ]
    },
    "evidence": {
      "enum": [
        "observed",
        "reported",
        "derived",
        "inferred",
        "unknown"
      ]
    },
    "authority": {
      "const": "historical_data_only"
    },
    "observed_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "admitted_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "corpus_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "content_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "entry_id",
          "version",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    },
    "lineage_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "status": {
      "enum": [
        "admitted",
        "stale",
        "revoked",
        "expired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "game_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "required": [
    "schema",
    "entry_id",
    "version",
    "scope",
    "branch_id",
    "source_record_id",
    "kind",
    "evidence",
    "authority",
    "observed_seq",
    "admitted_seq",
    "corpus_generation",
    "content_ref",
    "sha256",
    "byte_length",
    "parents",
    "lineage_depth",
    "status",
    "created_at",
    "expires_at",
    "game_profile"
  ]
}
