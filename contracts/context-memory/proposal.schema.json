{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-memory:proposal:v1",
  "title": "Proposed Phase 3 proposal contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-memory.proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {
      "enum": [
        "extractive",
        "abstractive"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "entry_id",
          "version",
          "sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "cutoff": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "corpus_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "support": {
            "enum": [
              "extractive",
              "reported",
              "inferred",
              "unknown",
              "contradictory"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "entry_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "entry_id",
                    "version",
                    "sha256"
                  ]
                },
                "start_byte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "quote_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source",
                "start_byte",
                "end_byte",
                "quote_sha256"
              ]
            },
            "minItems": 1,
            "maxItems": 16
          },
          "uncertainty": {
            "type": "string",
            "maxLength": 512
          },
          "applicability": {
            "enum": [
              "historical",
              "conditional",
              "unknown"
            ]
          }
        },
        "required": [
          "claim_id",
          "text",
          "support",
          "citations",
          "uncertainty",
          "applicability"
        ]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 32
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 16
    },
    "lineage_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "status": {
      "enum": [
        "generated",
        "machine_checked",
        "review_required",
        "rejected",
        "stale"
      ]
    },
    "content_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "source_reconstruction": {
      "enum": [
        "available",
        "partial",
        "unavailable"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "applied": {
      "const": false
    }
  },
  "required": [
    "schema",
    "proposal_id",
    "version",
    "scope",
    "branch_id",
    "kind",
    "sources",
    "cutoff",
    "corpus_generation",
    "claims",
    "omissions",
    "contradictions",
    "lineage_depth",
    "status",
    "content_ref",
    "sha256",
    "byte_length",
    "source_reconstruction",
    "created_at",
    "expires_at",
    "applied"
  ]
}
