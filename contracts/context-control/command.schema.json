              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "agent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "required": [
            "project_id",
            "run_id",
            "episode_id",
            "agent_id"
          ]
        },
