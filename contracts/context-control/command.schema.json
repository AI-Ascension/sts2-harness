        "kind": {
          "const": "commit"
        },
        "expected_active_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "preview_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "approved_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "scope",
        "idempotency_key",
        "command_window_id",
        "expected_control_version",
        "kind",
        "expected_active_revision_id",
        "preview_id",
        "approved_manifest_sha256"
      ]
    },
