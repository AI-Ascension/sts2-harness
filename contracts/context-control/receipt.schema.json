{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-control:receipt:v1",
  "title": "Proposed Phase 2 receipt contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-control.receipt.v1"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "kind": {
      "enum": [
        "pause",
        "commit",
        "resume"
      ]
    },
    "status": {
      "enum": [
        "accepted",
        "pending",
        "completed",
        "rejected",
        "blocked",
        "unknown"
      ]
    },
    "effect": {
      "enum": [
        "none",
        "pause_latched",
        "paused_ready",
        "revision_committed",
        "resume_claimed",
        "scheduler_released"
      ]
    },
    "control_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "paused": {
      "type": "boolean"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "command_id",
    "scope",
    "kind",
    "status",
    "effect",
    "control_version",
    "active_revision_id",
    "paused",
    "reason_code",
    "observed_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "commit"
          },
          "status": {
            "const": "completed"
          },
          "effect": {
            "const": "revision_committed"
          }
        }
      },
      "then": {
        "properties": {
          "paused": {
            "const": true
          }
        }
      }
    }
  ]
}
