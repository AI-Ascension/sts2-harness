{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-control:state:v1",
  "title": "Proposed Phase 2 state contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-control.state.v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "status": {
      "enum": [
        "running",
        "pause_requested",
        "draining_provider",
        "reconciling_action",
        "paused_ready",
        "paused_stale",
        "paused_committed",
        "blocked_recovery",
        "stopped"
      ]
    },
    "control_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "controller_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "gate_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "plan_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "pause_latched": {
      "type": "boolean"
    },
    "stop_latched": {
      "type": "boolean"
    },
    "outstanding_provider_attempts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "unresolved_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "boundary": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "project_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "episode_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "agent_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "required": [
                "project_id",
                "run_id",
                "episode_id",
                "agent_id"
              ]
            },
            "state_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "catalog_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "controller_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "gate_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "control_version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lease_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "adapter_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "adapter_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "configuration_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "output_schema_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "capabilities_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "authorization_policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "required": [
            "scope",
            "state_id",
            "generation",
            "observation_sha256",
            "catalog_sha256",
            "controller_epoch",
            "gate_epoch",
            "control_version",
            "lease_epoch",
            "adapter_revision",
            "adapter_sha256",
            "model",
            "configuration_sha256",
            "output_schema_sha256",
            "capabilities_sha256",
            "authorization_policy_version"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "command_window_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "command_window_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema",
    "scope",
    "status",
    "control_version",
    "controller_epoch",
    "gate_epoch",
    "plan_epoch",
    "active_revision_id",
    "pause_latched",
    "stop_latched",
    "outstanding_provider_attempts",
    "unresolved_operations",
    "boundary",
    "command_window_id",
    "command_window_expires_at",
    "last_sequence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "paused_ready",
              "paused_committed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pause_latched": {
            "const": true
          },
          "outstanding_provider_attempts": {
            "maxItems": 0
          },
          "unresolved_operations": {
            "maxItems": 0
          },
          "boundary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "episode_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "agent_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                },
                "required": [
                  "project_id",
                  "run_id",
                  "episode_id",
                  "agent_id"
                ]
              },
              "state_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "observation_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "catalog_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "controller_epoch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "gate_epoch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "control_version": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lease_epoch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "adapter_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "adapter_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "configuration_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_schema_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "capabilities_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "authorization_policy_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            },
            "required": [
              "scope",
              "state_id",
              "generation",
              "observation_sha256",
              "catalog_sha256",
              "controller_epoch",
              "gate_epoch",
              "control_version",
              "lease_epoch",
              "adapter_revision",
              "adapter_sha256",
              "model",
              "configuration_sha256",
              "output_schema_sha256",
              "capabilities_sha256",
              "authorization_policy_version"
            ]
          }
        }
      }
    }
  ]
}
