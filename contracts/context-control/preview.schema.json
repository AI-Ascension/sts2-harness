{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-control:preview:v1",
  "title": "Proposed Phase 2 preview contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-control.preview.v1"
    },
    "preview_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "draft_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "draft_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "base_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "episode_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "agent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "required": [
            "project_id",
            "run_id",
            "episode_id",
            "agent_id"
          ]
        },
        "state_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controller_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "gate_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "control_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "adapter_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capabilities_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "scope",
        "state_id",
        "generation",
        "observation_sha256",
        "catalog_sha256",
        "controller_epoch",
        "gate_epoch",
        "control_version",
        "lease_epoch",
        "adapter_revision",
        "adapter_sha256",
        "model",
        "configuration_sha256",
        "output_schema_sha256",
        "capabilities_sha256",
        "authorization_policy_version"
      ]
    },
    "applicable": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 32,
      "minItems": 0,
      "uniqueItems": true
    },
    "prepared_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "enum": [
              "stdin",
              "serialized_http_body",
              "output_schema",
              "configuration",
              "attachment"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "protected": {
            "type": "boolean"
          },
          "content_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "required": [
          "component_id",
          "ordinal",
          "kind",
          "sha256",
          "bytes",
          "protected",
          "content_ref"
        ]
      },
      "maxItems": 128,
      "minItems": 0
    },
    "selected_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "item_id",
          "version",
          "sha256"
        ]
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "budget_status": {
      "enum": [
        "within_known_local_limit",
        "bounded_unknown_total",
        "exceeded",
        "unavailable"
      ]
    },
    "unknown_total_risk_acknowledged": {
      "type": "boolean"
    },
    "provider_added_context": {
      "const": "not_exposed"
    },
    "model_execution_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "effect_class": {
      "const": "local_preparation_only"
    }
  },
  "required": [
    "schema",
    "preview_id",
    "scope",
    "draft_id",
    "draft_version",
    "base_revision_id",
    "boundary",
    "applicable",
    "blockers",
    "prepared_manifest_sha256",
    "components",
    "selected_items",
    "budget_status",
    "unknown_total_risk_acknowledged",
    "provider_added_context",
    "model_execution_id",
    "provider_attempt_id",
    "expires_at",
    "effect_class"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "applicable": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          },
          "prepared_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "components": {
            "minItems": 1
          },
          "model_execution_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "provider_attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "budget_status": {
            "enum": [
              "within_known_local_limit",
              "bounded_unknown_total"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicable": {
            "const": true
          },
          "budget_status": {
            "const": "bounded_unknown_total"
          }
        }
      },
      "then": {
        "properties": {
          "unknown_total_risk_acknowledged": {
            "const": true
          }
        }
      }
    }
  ]
}
