{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI-Ascension/sts2-harness/contracts/management-recovery/submission-v1.schema.json",
  "title": "Harness V1 submission recovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "state", "workflow_run_id", "response", "error"],
  "properties": {
    "schema_version": {"const": "ascension.workflow-submission/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "state": {"enum": ["missing", "pending", "submitted", "failed"]},
    "workflow_run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "response": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/submission"}]},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "missing"}}},
      "then": {"properties": {"workflow_run_id": {"type": "null"}, "response": {"type": "null"}, "error": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"const": "pending"}}},
      "then": {"properties": {"response": {"type": "null"}, "error": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"const": "submitted"}}},
      "then": {"properties": {"workflow_run_id": {"type": "string"}, "response": {"$ref": "#/$defs/submission"}, "error": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"const": "failed"}}},
      "then": {"properties": {"response": {"type": "null"}, "error": {"$ref": "#/$defs/error"}}}
    }
  ],
  "$defs": {
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workflow_run_id", "run_revision", "status"],
      "properties": {
        "schema_version": {"const": "ascension.management/v1"},
        "workflow_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_revision": {"type": "integer", "minimum": 0},
        "status": {"enum": ["created", "validated", "running", "waiting_for_provider", "waiting_for_game", "pausing", "paused", "cancelling", "reconciling", "completed", "failed", "cancelled", "needs_operator"]}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "code", "message"],
      "properties": {
        "class": {"enum": ["invalid_input", "capability", "conflict", "forbidden", "unresolved", "write_state_unknown", "unavailable", "budget", "store", "replay", "authentication"]},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
