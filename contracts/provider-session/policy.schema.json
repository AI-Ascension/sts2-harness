{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:provider-session:policy:v1",
  "title": "Harness provider-session policy contract",
  "description": "Provider-session admission policy. NOTE: this policy has no `provenance` field and deliberately gains none. The capabilities descriptor's `provenance` records how a build was qualified, and it is NOT an admission control: `NativeCapabilities::validate()` never reads it and every provenance value is equally admissible. Adding a policy floor here would be a wire-format change that could not be honestly evaluated, because the strongest provenance value (`live_provider`) asserts a runtime event that happened outside the process and which no field in either contract can witness. Do not add one under the impression that the field is already a gate. See #755.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.provider-session.policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "mode": {
      "enum": [
        "disabled",
        "fixture_only",
        "inspect_only",
        "enabled"
      ]
    },
    "continuity": {
      "enum": [
        "strict_reviewed",
        "observed_persistent"
      ]
    },
    "credential_realm_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cross_scope_fork": {
      "const": false
    },
    "reconnect_resumes_gameplay": {
      "const": false
    },
    "compaction_generation_permission_required": {
      "const": true
    },
    "max_completed_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "history_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "automatic_transform_policy": {
      "enum": [
        "deny_and_fence",
        "explicit_bounded_observed"
      ]
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema",
    "policy_id",
    "scope",
    "version",
    "mode",
    "continuity",
    "credential_realm_ref",
    "profile_sha256",
    "cross_scope_fork",
    "reconnect_resumes_gameplay",
    "compaction_generation_permission_required",
    "max_completed_turns",
    "history_ttl_seconds",
    "automatic_transform_policy",
    "epoch"
  ]
}
