{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"sts2-game-information-content-manifest-v1",
  "title":"STS2 typed game-information content manifest v1",
  "oneOf":[{"$ref":"#/$defs/response"},{"$ref":"#/$defs/error"}],
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._:/-]+$"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nullable_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "package":{"type":"object","additionalProperties":false,"required":["package_id","package_version","order"],"properties":{"package_id":{"$ref":"#/$defs/id"},"package_version":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"order":{"type":"integer","minimum":0,"maximum":4294967295}}},
    "family":{"type":"object","additionalProperties":false,"required":["entity_kind","handled","definition_count"],"properties":{"entity_kind":{"$ref":"#/$defs/id"},"handled":{"type":"boolean"},"definition_count":{"type":"integer","minimum":0,"maximum":1048576}}},
    "origin":{"type":"object","additionalProperties":false,"required":["package_id","package_version"],"properties":{"package_id":{"$ref":"#/$defs/nullable_id"},"package_version":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}}},
    "definition":{"type":"object","additionalProperties":false,"required":["entity_kind","namespaced_id","handled","origin","override_chain","semantic_revision","localized_text_revision"],"properties":{"entity_kind":{"$ref":"#/$defs/id"},"namespaced_id":{"$ref":"#/$defs/id"},"handled":{"type":"boolean"},"origin":{"$ref":"#/$defs/origin"},"override_chain":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/id"}},"semantic_revision":{"$ref":"#/$defs/digest"},"localized_text_revision":{"$ref":"#/$defs/digest"}}},
    "manifest":{"type":"object","additionalProperties":false,"required":["game_build","adapter_compatibility","catalog_generation","locale","packages","families","definitions","content_set_revision","localized_text_revision","inventory_revision"],"properties":{"game_build":{"$ref":"#/$defs/id"},"adapter_compatibility":{"$ref":"#/$defs/id"},"catalog_generation":{"type":"integer","minimum":0,"maximum":9007199254740991},"locale":{"$ref":"#/$defs/id"},"packages":{"type":"array","maxItems":4096,"items":{"$ref":"#/$defs/package"}},"families":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/family"}},"definitions":{"type":"array","maxItems":1048576,"items":{"$ref":"#/$defs/definition"}},"content_set_revision":{"$ref":"#/$defs/digest"},"localized_text_revision":{"$ref":"#/$defs/digest"},"inventory_revision":{"$ref":"#/$defs/digest"}}},
    "reason":{"enum":[null,"source_unavailable","source_access_denied","source_malformed","catalog_changed","invalid_identity","invalid_semantic_input","invalid_localized_text","invalid_package_version","duplicate_package","invalid_package_order","duplicate_entity_kind","unknown_entity_kind","duplicate_definition","unknown_origin_package","origin_package_version_mismatch","duplicate_override_reference","serialized_payload_too_large"]},
    "error_payload":{"type":"object","additionalProperties":false,"required":["code","reason"],"properties":{"code":{"enum":["missing_capability","access_denied","malformed","result_limit_exceeded"]},"reason":{"$ref":"#/$defs/reason"}},"oneOf":[{"properties":{"code":{"const":"missing_capability"},"reason":{"enum":[null,"source_unavailable"]}}},{"properties":{"code":{"const":"access_denied"},"reason":{"enum":[null,"source_access_denied"]}}},{"properties":{"code":{"const":"malformed"},"reason":{"enum":[null,"source_malformed","catalog_changed","invalid_identity","invalid_semantic_input","invalid_localized_text","invalid_package_version","duplicate_package","invalid_package_order","duplicate_entity_kind","unknown_entity_kind","duplicate_definition","unknown_origin_package","origin_package_version_mismatch","duplicate_override_reference"]}}},{"properties":{"code":{"const":"result_limit_exceeded"},"reason":{"enum":[null,"serialized_payload_too_large"]}}}]},
    "base":{"type":"object","additionalProperties":false,"required":["protocol_version","schema_digest","provenance","correlation_id","kind","manifest","error"],"properties":{"protocol_version":{"const":"game-information-content-manifest-v1"},"schema_digest":{"$ref":"#/$defs/digest"},"provenance":{"type":"object","additionalProperties":false,"required":["artifact","source","generator"],"properties":{"artifact":{"const":"sts2-protocol/game-information-content-manifest-v1"},"source":{"const":"schemas/game-information-content-manifest-v1.schema.json"},"generator":{"const":"hand-authored"}}},"correlation_id":{"$ref":"#/$defs/id"},"kind":{"enum":["content_manifest_response","error_response"]},"manifest":{"anyOf":[{"$ref":"#/$defs/manifest"},{"type":"null"}]},"error":{"anyOf":[{"$ref":"#/$defs/error_payload"},{"type":"null"}]}}},
    "response":{"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"content_manifest_response"},"manifest":{"$ref":"#/$defs/manifest"},"error":{"type":"null"}}}]},
    "error":{"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"error_response"},"manifest":{"type":"null"},"error":{"$ref":"#/$defs/error_payload"}}}]}
  }
}
