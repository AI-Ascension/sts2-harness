{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-harness/exo-bridge/v1",
  "title": "STS2 Exo bridge capability descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "identity",
    "decision_kinds",
    "profile_support",
    "context_modes",
    "platforms",
    "limits",
    "lifecycle",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "sts2.exo-capability-v1"},
    "contract_version": {"const": "sts2-exo-bridge-v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "decision_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["plan", "action", "wait", "reobserve", "recovery"]}
    },
    "profile_support": {"$ref": "#/$defs/profile_support"},
    "context_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["fresh", "continuity"]}
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "linux_x86_64"}
    },
    "limits": {"$ref": "#/$defs/limits"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "not": {"pattern": "^0+$"}
    },
    "identity_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "package_digest",
        "extension_digest",
        "bridge_digest",
        "model_binding",
        "prompt_digest",
        "tool_digest",
        "config_digest",
        "contract_version",
        "native_instance_id"
      ],
      "properties": {
        "source_revision": {"$ref": "#/$defs/revision"},
        "package_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "extension_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "bridge_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "model_binding": {"anyOf": [{"$ref": "#/$defs/identity_text"}, {"type": "null"}]},
        "prompt_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "tool_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "config_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "contract_version": {"const": "sts2-exo-bridge-v1"},
        "native_instance_id": {"anyOf": [{"$ref": "#/$defs/identity_text"}, {"type": "null"}]}
      }
    },
    "state": {"enum": ["supported", "unsupported", "unverified"]},
    "profile_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "map", "expert"],
      "properties": {
        "standard": {"$ref": "#/$defs/state"},
        "map": {"$ref": "#/$defs/state"},
        "expert": {"$ref": "#/$defs/state"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_standard_request_bytes",
        "max_map_request_bytes",
        "max_response_bytes",
        "max_event_bytes",
        "max_turns",
        "max_turn_time_millis",
        "max_concurrency",
        "max_tool_round_trips"
      ],
      "properties": {
        "max_standard_request_bytes": {"type": "integer", "minimum": 1, "maximum": 131072},
        "max_map_request_bytes": {"type": "integer", "minimum": 1, "maximum": 393443},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_event_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_turns": {"type": "integer", "const": 1},
        "max_turn_time_millis": {"type": "integer", "minimum": 1, "maximum": 120000},
        "max_concurrency": {"type": "integer", "const": 1},
        "max_tool_round_trips": {"type": "integer", "const": 0}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellation", "recovery", "idempotency", "graceful_eof"],
      "properties": {
        "cancellation": {"$ref": "#/$defs/state"},
        "recovery": {"$ref": "#/$defs/state"},
        "idempotency": {"$ref": "#/$defs/state"},
        "graceful_eof": {"$ref": "#/$defs/state"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_decision", "turn_identity", "event_usage", "replay"],
      "properties": {
        "terminal_decision": {"$ref": "#/$defs/state"},
        "turn_identity": {"$ref": "#/$defs/state"},
        "event_usage": {"$ref": "#/$defs/state"},
        "replay": {"$ref": "#/$defs/state"}
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "control_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[\\u0020-\\u007E]+$"
    },
    "map_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\u0020-\\u007E]+$"
    },
    "decision": {
      "oneOf": [
        {"$ref": "#/$defs/plan_decision"},
        {"$ref": "#/$defs/action_decision"},
        {"$ref": "#/$defs/wait_decision"},
        {"$ref": "#/$defs/reobserve_decision"},
        {"$ref": "#/$defs/recovery_decision"}
      ]
    },
    "plan_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "action_ids", "rationale"],
      "properties": {
        "decision": {"const": "plan"},
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "action_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "action_id", "rationale"],
      "properties": {
        "decision": {"const": "action"},
        "action_id": {"$ref": "#/$defs/id"},
        "rationale": {"$ref": "#/$defs/text"},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "wait_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"const": "wait"},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "reobserve_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"const": "reobserve"},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "recovery_decision": {
      "oneOf": [
        {"$ref": "#/$defs/recovery_without_operation"},
        {"$ref": "#/$defs/recovery_with_operation"}
      ]
    },
    "recovery_without_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "recovery_kind", "rationale"],
      "properties": {
        "decision": {"const": "recovery"},
        "recovery_kind": {"enum": ["reobserve", "release_lease", "stop_episode"]},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "recovery_with_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "recovery_kind", "operation_id", "rationale"],
      "properties": {
        "decision": {"const": "recovery"},
        "recovery_kind": {"const": "reconcile"},
        "operation_id": {"$ref": "#/$defs/id"},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "map_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "generation",
        "schema_version",
        "projection_version",
        "game_build",
        "mod_version",
        "map_instance_id",
        "act_id",
        "scope_id",
        "availability",
        "completeness",
        "freshness",
        "reason",
        "nodes",
        "edges",
        "position",
        "history",
        "terminal_node_ids",
        "bindings"
      ],
      "properties": {
        "state_id": {"$ref": "#/$defs/id"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "schema_version": {"const": "visible-map-v1"},
        "projection_version": {"const": "runtime-map-v1"},
        "game_build": {"$ref": "#/$defs/map_text"},
        "mod_version": {"$ref": "#/$defs/map_text"},
        "map_instance_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "act_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "scope_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "availability": {"const": "available"},
        "completeness": {"const": "complete"},
        "freshness": {"const": "current"},
        "reason": {"type": "null"},
        "nodes": {"type": "array", "maxItems": 256},
        "edges": {"type": "array", "maxItems": 1024},
        "position": {"type": "object"},
        "history": {"type": "array"},
        "terminal_node_ids": {"type": "array"},
        "bindings": {"type": "array", "maxItems": 256}
      }
    },
    "map_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "schema_digest", "snapshot_digest", "snapshot"],
      "properties": {
        "profile": {"const": "runtime-map-v1"},
        "schema_digest": {"const": "ceab0d2dfc471d1ec36d12edaf4654b8c7fdced06548bf47265e11c63f98115b"},
        "snapshot_digest": {"$ref": "#/$defs/hash"},
        "snapshot": {"$ref": "#/$defs/map_snapshot"}
      }
    },
    "decision_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider_revision",
        "model_execution_id",
        "state_id",
        "generation",
        "observation",
        "legal_action_ids",
        "objective",
        "hard_constraints",
        "max_response_bytes"
      ],
      "properties": {
        "schema": {"enum": ["sts2.exo-decision-v1", "sts2.exo-decision-map-v1"]},
        "provider_revision": {"$ref": "#/$defs/revision"},
        "model_execution_id": {"$ref": "#/$defs/id"},
        "state_id": {"$ref": "#/$defs/id"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "observation": {"type": "object"},
        "legal_action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "objective": {"$ref": "#/$defs/text"},
        "hard_constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/text"}
        },
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "map_context": {"$ref": "#/$defs/map_context"},
        "management_profile": {"const": "management-enabled"},
        "management_context": {}
      },
      "allOf": [
        {
          "if": {
            "required": ["schema"],
            "properties": {"schema": {"const": "sts2.exo-decision-v1"}}
          },
          "then": {"not": {"required": ["map_context"]}}
        },
        {
          "if": {
            "required": ["schema"],
            "properties": {"schema": {"const": "sts2.exo-decision-map-v1"}}
          },
          "then": {"required": ["map_context"]}
        },
        {
          "if": {"required": ["management_profile"]},
          "then": {"required": ["management_context"]}
        },
        {
          "if": {"required": ["management_context"]},
          "then": {"required": ["management_profile"]}
        }
      ]
    },
    "request_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_version", "request_id", "turn_id", "request"],
      "properties": {
        "wire_version": {"const": "sts2.exo-bridge-wire-v1"},
        "request_id": {"$ref": "#/$defs/control_id"},
        "turn_id": {"$ref": "#/$defs/control_id"},
        "request": {"$ref": "#/$defs/decision_request"}
      }
    },
    "decision_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_version", "request_id", "turn_id", "outcome"],
      "properties": {
        "wire_version": {"const": "sts2.exo-bridge-wire-v1"},
        "request_id": {"$ref": "#/$defs/control_id"},
        "turn_id": {"$ref": "#/$defs/control_id"},
        "outcome": {"enum": ["decision", "cancelled", "failed"]},
        "decision": {"anyOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]},
        "error_code": {"anyOf": [{"$ref": "#/$defs/error_code"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "decision"}}
          },
          "then": {
            "required": ["decision"],
            "properties": {
              "decision": {"$ref": "#/$defs/decision"},
              "error_code": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "cancelled"}}
          },
          "then": {
            "properties": {
              "decision": {"type": "null"},
              "error_code": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "failed"}}
          },
          "then": {
            "required": ["error_code"],
            "properties": {
              "decision": {"type": "null"},
              "error_code": {"$ref": "#/$defs/error_code"}
            }
          }
        }
      ]
    }
  }
}
