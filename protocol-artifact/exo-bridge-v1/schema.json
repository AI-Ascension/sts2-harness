{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-harness/exo-bridge/v1",
  "title": "STS2 Exo bridge capability descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "identity",
    "decision_kinds",
    "profile_support",
    "context_modes",
    "platforms",
    "limits",
    "lifecycle",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "sts2.exo-capability-v1"},
    "contract_version": {"const": "sts2-exo-bridge-v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "decision_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["plan", "action", "wait", "reobserve", "recovery"]}
    },
    "profile_support": {"$ref": "#/$defs/profile_support"},
    "context_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["fresh", "continuity"]}
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "linux_x86_64"}
    },
    "limits": {"$ref": "#/$defs/limits"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "identity_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "package_digest",
        "extension_digest",
        "bridge_digest",
        "model_binding",
        "prompt_digest",
        "tool_digest",
        "config_digest",
        "contract_version",
        "native_instance_id"
      ],
      "properties": {
        "source_revision": {"$ref": "#/$defs/revision"},
        "package_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "extension_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "bridge_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "model_binding": {"anyOf": [{"$ref": "#/$defs/identity_text"}, {"type": "null"}]},
        "prompt_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "tool_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "config_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "contract_version": {"const": "sts2-exo-bridge-v1"},
        "native_instance_id": {"anyOf": [{"$ref": "#/$defs/identity_text"}, {"type": "null"}]}
      }
    },
    "state": {"enum": ["supported", "unsupported", "unverified"]},
    "profile_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "map", "expert"],
      "properties": {
        "standard": {"$ref": "#/$defs/state"},
        "map": {"$ref": "#/$defs/state"},
        "expert": {"$ref": "#/$defs/state"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_standard_request_bytes",
        "max_map_request_bytes",
        "max_response_bytes",
        "max_event_bytes",
        "max_turns",
        "max_turn_time_millis",
        "max_concurrency",
        "max_tool_round_trips"
      ],
      "properties": {
        "max_standard_request_bytes": {"type": "integer", "minimum": 1, "maximum": 131072},
        "max_map_request_bytes": {"type": "integer", "minimum": 1, "maximum": 393443},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_event_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_turns": {"type": "integer", "const": 1},
        "max_turn_time_millis": {"type": "integer", "minimum": 1, "maximum": 120000},
        "max_concurrency": {"type": "integer", "const": 1},
        "max_tool_round_trips": {"type": "integer", "const": 0}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellation", "recovery", "idempotency", "graceful_eof"],
      "properties": {
        "cancellation": {"$ref": "#/$defs/state"},
        "recovery": {"$ref": "#/$defs/state"},
        "idempotency": {"$ref": "#/$defs/state"},
        "graceful_eof": {"$ref": "#/$defs/state"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_decision", "turn_identity", "event_usage", "replay"],
      "properties": {
        "terminal_decision": {"$ref": "#/$defs/state"},
        "turn_identity": {"$ref": "#/$defs/state"},
        "event_usage": {"$ref": "#/$defs/state"},
        "replay": {"$ref": "#/$defs/state"}
      }
    },
    "control_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"enum": ["plan", "action", "wait", "reobserve", "recovery"]},
        "action_id": {"$ref": "#/$defs/control_id"},
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/control_id"}
        },
        "rationale": {"type": "string", "minLength": 1, "maxLength": 512},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "recovery_kind": {
          "enum": ["reobserve", "reconcile", "release_lease", "stop_episode"]
        },
        "operation_id": {"$ref": "#/$defs/control_id"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "action"}}},
          "then": {"required": ["action_id"]}
        },
        {
          "if": {"properties": {"decision": {"const": "plan"}}},
          "then": {"required": ["action_ids"]}
        },
        {
          "if": {"properties": {"decision": {"const": "recovery"}}},
          "then": {"required": ["recovery_kind"]}
        }
      ]
    },
    "decision_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider_revision",
        "model_execution_id",
        "state_id",
        "generation",
        "observation",
        "legal_action_ids",
        "objective",
        "hard_constraints",
        "max_response_bytes"
      ],
      "properties": {
        "schema": {"enum": ["sts2.exo-decision-v1", "sts2.exo-decision-map-v1"]},
        "provider_revision": {"$ref": "#/$defs/revision"},
        "model_execution_id": {"$ref": "#/$defs/control_id"},
        "state_id": {"$ref": "#/$defs/control_id"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "observation": {"type": "object"},
        "legal_action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/control_id"}
        },
        "objective": {"type": "string", "minLength": 1, "maxLength": 512},
        "hard_constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "map_context": {"type": ["object", "null"]},
        "management_profile": {"const": "management-enabled"},
        "management_context": {"type": ["object", "null"]}
      }
    },
    "request_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_version", "request_id", "turn_id", "request"],
      "properties": {
        "wire_version": {"const": "sts2.exo-bridge-wire-v1"},
        "request_id": {"$ref": "#/$defs/control_id"},
        "turn_id": {"$ref": "#/$defs/control_id"},
        "request": {"$ref": "#/$defs/decision_request"}
      }
    },
    "decision_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wire_version",
        "request_id",
        "turn_id",
        "outcome",
        "decision",
        "error_code"
      ],
      "properties": {
        "wire_version": {"const": "sts2.exo-bridge-wire-v1"},
        "request_id": {"$ref": "#/$defs/control_id"},
        "turn_id": {"$ref": "#/$defs/control_id"},
        "outcome": {"enum": ["decision", "cancelled", "failed"]},
        "decision": {"anyOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]},
        "error_code": {"anyOf": [{"$ref": "#/$defs/error_code"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "decision"}}},
          "then": {
            "properties": {
              "decision": {"$ref": "#/$defs/decision"},
              "error_code": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "cancelled"}}},
          "then": {
            "properties": {
              "decision": {"type": "null"},
              "error_code": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "failed"}}},
          "then": {
            "properties": {
              "decision": {"type": "null"},
              "error_code": {"$ref": "#/$defs/error_code"}
            }
          }
        }
      ]
    }
  }
}
