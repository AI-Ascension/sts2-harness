{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-harness/exo-bridge/v1",
  "title": "STS2 Exo bridge capability descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "identity",
    "decision_kinds",
    "profile_support",
    "context_modes",
    "platforms",
    "limits",
    "lifecycle",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "sts2.exo-capability-v1"},
    "contract_version": {"const": "sts2-exo-bridge-v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "decision_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["plan", "action", "wait", "reobserve", "recovery"]}
    },
    "profile_support": {"$ref": "#/$defs/profile_support"},
    "context_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["fresh", "continuity"]}
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "linux_x86_64"}
    },
    "limits": {"$ref": "#/$defs/limits"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {"pattern": "^0+$"},
      "description": "A lowercase SHA-256 digest. The all-zero digest is rejected by both this schema and the Rust `valid_digest` validator."
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "not": {"pattern": "^0+$"}
    },
    "identity_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "provider_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "provider_endpoint": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^https://[A-Za-z0-9._:-]+(/[A-Za-z0-9._:/-]*)?$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every digest, model, provider, endpoint, and identity key must be present in this schema and is either a bounded value or null. The Rust `ExoIdentity` stores optional deployment axes, so an omitted key and an explicit null are equivalent there; this schema is intentionally stricter (fail-closed) and requires the explicit key. Executable preflight requires provider=openai and a reviewed https://api.openai.com endpoint; OpenRouter and unknown routes are rejected.",
      "required": [
        "source_revision",
        "package_digest",
        "extension_digest",
        "bridge_digest",
        "model_binding",
        "provider",
        "endpoint",
        "prompt_digest",
        "tool_digest",
        "config_digest",
        "contract_version",
        "native_instance_id"
      ],
      "properties": {
        "source_revision": {"$ref": "#/$defs/revision"},
        "package_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "extension_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "bridge_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "model_binding": {"anyOf": [{"$ref": "#/$defs/identity_text"}, {"type": "null"}]},
        "provider": {"anyOf": [{"$ref": "#/$defs/provider_identity"}, {"type": "null"}]},
        "endpoint": {"anyOf": [{"$ref": "#/$defs/provider_endpoint"}, {"type": "null"}]},
        "prompt_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "tool_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "config_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "contract_version": {"const": "sts2-exo-bridge-v1"},
        "native_instance_id": {"anyOf": [{"$ref": "#/$defs/identity_text"}, {"type": "null"}]}
      }
    },
    "state": {"enum": ["supported", "unsupported", "unverified"]},
    "profile_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "map", "expert"],
      "properties": {
        "standard": {"$ref": "#/$defs/state"},
        "map": {"$ref": "#/$defs/state"},
        "expert": {"$ref": "#/$defs/state"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_standard_request_bytes",
        "max_map_request_bytes",
        "max_response_bytes",
        "max_event_bytes",
        "max_turns",
        "max_turn_time_millis",
        "max_concurrency",
        "max_tool_round_trips"
      ],
      "properties": {
        "max_standard_request_bytes": {"type": "integer", "minimum": 1, "maximum": 131072},
        "max_map_request_bytes": {"type": "integer", "minimum": 1, "maximum": 393443},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_event_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_turns": {"type": "integer", "const": 1},
        "max_turn_time_millis": {"type": "integer", "minimum": 1, "maximum": 120000},
        "max_concurrency": {"type": "integer", "const": 1},
        "max_tool_round_trips": {"type": "integer", "const": 0}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellation", "recovery", "idempotency", "graceful_eof"],
      "properties": {
        "cancellation": {"$ref": "#/$defs/state"},
        "recovery": {"$ref": "#/$defs/state"},
        "idempotency": {"$ref": "#/$defs/state"},
        "graceful_eof": {"$ref": "#/$defs/state"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_decision", "turn_identity", "event_usage", "replay"],
      "properties": {
        "terminal_decision": {"$ref": "#/$defs/state"},
        "turn_identity": {"$ref": "#/$defs/state"},
        "event_usage": {"$ref": "#/$defs/state"},
        "replay": {"$ref": "#/$defs/state"}
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "control_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[\\u0020-\\u007E]+$"
    },
    "map_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\u0020-\\u007E]+$"
    },
    "map_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "decision": {
      "oneOf": [
        {"$ref": "#/$defs/plan_decision"},
        {"$ref": "#/$defs/action_decision"},
        {"$ref": "#/$defs/wait_decision"},
        {"$ref": "#/$defs/reobserve_decision"},
        {"$ref": "#/$defs/recovery_decision"}
      ]
    },
    "plan_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "action_ids", "rationale"],
      "properties": {
        "decision": {"const": "plan"},
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "action_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "action_id", "rationale"],
      "properties": {
        "decision": {"const": "action"},
        "action_id": {"$ref": "#/$defs/id"},
        "rationale": {"$ref": "#/$defs/text"},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "wait_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"const": "wait"},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "reobserve_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"const": "reobserve"},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "recovery_decision": {
      "oneOf": [
        {"$ref": "#/$defs/recovery_without_operation"},
        {"$ref": "#/$defs/recovery_with_operation"}
      ]
    },
    "recovery_without_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "recovery_kind", "rationale"],
      "properties": {
        "decision": {"const": "recovery"},
        "recovery_kind": {"enum": ["reobserve", "release_lease", "stop_episode"]},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "recovery_with_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "recovery_kind", "operation_id", "rationale"],
      "properties": {
        "decision": {"const": "recovery"},
        "recovery_kind": {"const": "reconcile"},
        "operation_id": {"$ref": "#/$defs/id"},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "observation": {
      "description": "Standard fair-play projection or the closed Runtime-v4 expert wire observation. The harness fair-play projection (harness_projection marker) is a separate provider-side form and is outside this bridge observation union.",
      "oneOf": [
        {"$ref": "#/$defs/standard_observation"},
        {"$ref": "#/$defs/expert_observation"}
      ]
    },
    "expert_observation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Closed Runtime-v4 expert observation. Faithful to protocol-artifact/runtime-v4-expert/schema.json and crates/harness/src/runtime_v4_expert_parse.rs (`shape_is_closed`/`WireObservation`). The bridge tightens legal_actions to at least one entry and uses uniqueItems to reject byte-identical action objects. The Rust parser additionally requires unique action_id values (distinct payloads can be schema-valid but parser-rejected), bounds expert text at 512 UTF-8 bytes (JSON Schema maxLength counts code points), and enforces hp<=max_hp; these semantic checks are fail-closed and exercised by whole-request conformance vectors.",
      "required": [
        "protocol_version",
        "schema_digest",
        "provenance",
        "profile",
        "state_id",
        "generation",
        "visible_seed",
        "run",
        "player",
        "state",
        "legal_actions"
      ],
      "properties": {
        "protocol_version": {"const": "runtime-v4-expert"},
        "schema_digest": {"const": "0ee034d5da83f34e9fa0ba23038738d56ef8cfccb1c6e752af3ab63d212c8e42"},
        "provenance": {"$ref": "#/$defs/expert_provenance"},
        "profile": {"const": "expert-state"},
        "state_id": {"$ref": "#/$defs/expert_identity"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "visible_seed": {"anyOf": [{"$ref": "#/$defs/expert_text"}, {"type": "null"}]},
        "run": {"$ref": "#/$defs/expert_run"},
        "player": {"$ref": "#/$defs/expert_player"},
        "state": {"$ref": "#/$defs/expert_state"},
        "legal_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "description": "Schema uniqueItems rejects byte-identical action objects. Semantic uniqueness of action_id values is enforced by the Rust parser; distinct payloads sharing an action_id are intentionally schema-valid/parser-rejected.",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/expert_legal_action"}
        }
      }
    },
    "standard_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "generation", "player", "state", "legal_actions"],
      "properties": {
        "state_id": {"$ref": "#/$defs/id"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "visible_seed": {
          "anyOf": [{"$ref": "#/$defs/observation_text"}, {"type": "null"}]
        },
        "player": {"$ref": "#/$defs/player"},
        "state": {"$ref": "#/$defs/game_state"},
        "legal_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/legal_action"}
        }
      }
    },
    "observation_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "max_hp", "energy", "gold", "hand", "deck", "discard", "exhaust"],
      "properties": {
        "hp": {"type": "integer", "minimum": 0, "maximum": 65535},
        "max_hp": {"type": "integer", "minimum": 0, "maximum": 65535},
        "energy": {"type": "integer", "minimum": 0, "maximum": 255},
        "gold": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "hand": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/card"}},
        "deck": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/card"}},
        "discard": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/card"}},
        "exhaust": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/card"}}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "name", "cost", "upgraded"],
      "properties": {
        "card_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/observation_text"},
        "cost": {"type": "integer", "minimum": 0, "maximum": 255},
        "upgraded": {"type": "boolean"}
      }
    },
    "enemy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enemy_id", "name", "hp", "max_hp", "intent"],
      "properties": {
        "enemy_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/observation_text"},
        "hp": {"type": "integer", "minimum": 0, "maximum": 65535},
        "max_hp": {"type": "integer", "minimum": 0, "maximum": 65535},
        "intent": {"$ref": "#/$defs/intent"}
      }
    },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "damage", "hits"],
          "properties": {
            "kind": {"const": "attack"},
            "damage": {"type": "integer", "minimum": 0, "maximum": 65535},
            "hits": {"type": "integer", "minimum": 1, "maximum": 255}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["defend", "buff", "debuff", "unknown"]}
          }
        }
      ]
    },
    "game_state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "characters"],
          "properties": {
            "state": {"const": "setup"},
            "characters": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/id"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "node_id", "options"],
          "properties": {
            "state": {"const": "map"},
            "node_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
            "options": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/id"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "turn_index", "enemies"],
          "properties": {
            "state": {"const": "combat"},
            "turn_index": {"type": "integer", "minimum": 0, "maximum": 65535},
            "enemies": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/enemy"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "options"],
          "properties": {
            "state": {"enum": ["reward", "rest"]},
            "options": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/id"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "items"],
          "properties": {
            "state": {"const": "shop"},
            "items": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/shop_item"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "choices"],
          "properties": {
            "state": {"enum": ["event", "selection"]},
            "choices": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/id"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {"state": {"const": "victory"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": {"const": "defeat"},
            "reason": {"anyOf": [{"$ref": "#/$defs/observation_text"}, {"type": "null"}]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "code"],
          "properties": {
            "state": {"const": "recovery"},
            "code": {"$ref": "#/$defs/id"}
          }
        }
      ]
    },
    "shop_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "name", "price"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/observation_text"},
        "price": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "legal_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "action"],
      "properties": {
        "action_id": {"$ref": "#/$defs/id"},
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "character_id"],
          "properties": {
            "kind": {"const": "start_run"},
            "character_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "node_id"],
          "properties": {
            "kind": {"const": "select_map_node"},
            "node_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "card_id", "target_id"],
          "properties": {
            "kind": {"const": "play_card"},
            "card_id": {"$ref": "#/$defs/id"},
            "target_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reward_id"],
          "properties": {
            "kind": {"const": "choose_reward"},
            "reward_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item_id"],
          "properties": {
            "kind": {"const": "shop_purchase"},
            "item_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "card_id"],
          "properties": {
            "kind": {"enum": ["shop_remove", "smith", "select_card"]},
            "card_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "player_id"],
          "properties": {
            "kind": {"const": "select_player"},
            "player_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "choice_id"],
          "properties": {
            "kind": {"const": "event_choice"},
            "choice_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "end_turn",
                "skip_reward",
                "rest",
                "confirm_victory",
                "save_quit",
                "proceed",
                "confirm_selection",
                "cancel_selection"
              ]
            }
          }
        }
      ]
    },
    "map_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "generation",
        "schema_version",
        "projection_version",
        "game_build",
        "mod_version",
        "map_instance_id",
        "act_id",
        "scope_id",
        "availability",
        "completeness",
        "freshness",
        "reason",
        "nodes",
        "edges",
        "position",
        "history",
        "terminal_node_ids",
        "bindings"
      ],
      "properties": {
        "state_id": {"$ref": "#/$defs/map_id"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "schema_version": {"const": "visible-map-v1"},
        "projection_version": {"const": "runtime-map-v1"},
        "game_build": {"$ref": "#/$defs/map_text"},
        "mod_version": {"$ref": "#/$defs/map_text"},
        "map_instance_id": {"$ref": "#/$defs/map_id"},
        "act_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "scope_id": {"$ref": "#/$defs/map_id"},
        "availability": {"const": "available"},
        "completeness": {"const": "complete"},
        "freshness": {"const": "current"},
        "reason": {"type": "null"},
        "nodes": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/map_node"}
        },
        "edges": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/map_edge"}
        },
        "position": {"$ref": "#/$defs/map_position"},
        "history": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/map_id"}
        },
        "terminal_node_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/map_id"}
        },
        "bindings": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/map_binding"}
        }
      }
    },
    "map_node": {
      "type": "object",
      "additionalProperties": false,
