          }
        },
        {
          "if": {
            "required": ["schema"],
            "properties": {"schema": {"const": "sts2.exo-decision-map-v1"}}
          },
          "then": {
            "required": ["map_context"],
            "properties": {"map_context": {"not": {"type": "null"}}}
          }
        },
        {
          "if": {
            "required": ["management_profile"],
            "properties": {"management_profile": {"const": "management-enabled"}}
          },
          "then": {
            "required": ["management_context"],
            "properties": {"management_context": {"not": {"type": "null"}}}
          }
        },
        {
          "if": {
            "required": ["management_context"],
            "properties": {"management_context": {"not": {"type": "null"}}}
          },
          "then": {
            "required": ["management_profile"],
            "properties": {"management_profile": {"const": "management-enabled"}}
          }
        },
        {
          "if": {
            "required": ["management_profile"],
            "properties": {"management_profile": {"type": "null"}}
          },
          "then": {
            "properties": {"management_context": {"type": "null"}}
          }
        },
        {
