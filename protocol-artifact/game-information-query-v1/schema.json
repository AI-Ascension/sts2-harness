{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-game-information-query-v1",
  "title": "STS2 game-information query and snapshot contract v1",
  "description": "Bounded, read-only, versioned static and live game-information queries. Revision 2 makes binding, typed-value, page-state, and byte-accounting relationships explicit.",
  "oneOf": [
    {"$ref": "#/$defs/query_request"},
    {"$ref": "#/$defs/query_response"},
    {"$ref": "#/$defs/capabilities_response"},
    {"$ref": "#/$defs/error_response"}
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~:/+=-]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {"pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"}
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {"pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"}
    },
    "safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entity_kind": {
      "enum": [
        "card",
        "character",
        "enemy",
        "event",
        "map_node",
        "potion",
        "power",
        "relic",
        "room",
        "status"
      ]
    },
    "query_kind": {
      "enum": ["list", "search", "get", "detail", "availability"]
    },
    "projection": {
      "enum": ["summary", "standard", "full"]
    },
    "detail_level": {
      "enum": ["summary", "standard", "full"]
    },
    "field_name": {
      "enum": [
        "amount",
        "cost",
        "description",
        "display_name",
        "flags",
        "owner",
        "position",
        "rarity",
        "source_id",
        "tags"
      ]
    },
    "visibility_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {"const": "sts2-protocol/game-information-query-v1"},
        "source": {"const": "schemas/game-information-query-v1.schema.json"},
        "generator": {"const": "hand-authored"}
      },
      "required": ["artifact", "source", "generator"]
    },
    "definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_manifest_id": {"$ref": "#/$defs/identity"},
        "entity_kind": {"$ref": "#/$defs/entity_kind"},
        "namespaced_id": {"$ref": "#/$defs/identity"},
        "variant": {
          "anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]
        }
      },
      "required": [
        "content_manifest_id",
        "entity_kind",
        "namespaced_id",
        "variant"
      ]
    },
    "instance_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_id": {"$ref": "#/$defs/identity"},
        "run_id": {"$ref": "#/$defs/identity"},
        "epoch": {"$ref": "#/$defs/safe_integer"},
        "entity_kind": {"$ref": "#/$defs/entity_kind"},
        "entity_id": {"$ref": "#/$defs/identity"}
      },
      "required": [
        "instance_id",
        "run_id",
        "epoch",
        "entity_kind",
        "entity_id"
      ]
    },
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/identity"},
        "instance_ref": {"$ref": "#/$defs/instance_ref"},
        "state_generation": {"$ref": "#/$defs/safe_integer"}
      },
      "required": ["snapshot_id", "instance_ref", "state_generation"]
    },
    "query_binding": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["static", "live"]},
            "content_manifest_id": {"$ref": "#/$defs/identity"},
            "locale": {"$ref": "#/$defs/locale"},
            "visibility_scope": {"$ref": "#/$defs/visibility_scope"},
            "instance_ref": {
              "anyOf": [{"$ref": "#/$defs/instance_ref"}, {"type": "null"}]
            },
            "snapshot_ref": {
              "anyOf": [{"$ref": "#/$defs/snapshot_ref"}, {"type": "null"}]
            }
          },
          "required": [
            "mode",
            "content_manifest_id",
            "locale",
            "visibility_scope",
            "instance_ref",
            "snapshot_ref"
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "mode": {"const": "static"},
                "instance_ref": {"type": "null"},
                "snapshot_ref": {"type": "null"}
              }
            },
            {
              "properties": {
                "mode": {"const": "live"},
                "instance_ref": {"$ref": "#/$defs/instance_ref"},
                "snapshot_ref": {"$ref": "#/$defs/snapshot_ref"}
              }
            }
          ]
        }
      ]
    },
    "query_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition_ref": {
          "anyOf": [{"$ref": "#/$defs/definition_ref"}, {"type": "null"}]
        },
        "instance_ref": {
          "anyOf": [{"$ref": "#/$defs/instance_ref"}, {"type": "null"}]
        }
      },
      "required": ["definition_ref", "instance_ref"]
    },
    "query_filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]
        },
        "namespaced_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/identity"}
        },
        "definition_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/definition_ref"}
        },
        "instance_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/identity"}
        }
      },
      "required": [
        "display_name",
        "namespaced_ids",
        "definition_refs",
        "instance_ids"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_items": {"type": "integer", "minimum": 1, "maximum": 128},
        "item_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "page_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "text_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      },
      "required": ["page_items", "item_bytes", "page_bytes", "text_bytes"]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query_kind": {"$ref": "#/$defs/query_kind"},
        "entity_kind": {"$ref": "#/$defs/entity_kind"},
        "target": {"$ref": "#/$defs/query_target"},
        "filters": {"$ref": "#/$defs/query_filters"},
        "projection": {"$ref": "#/$defs/projection"},
        "detail_level": {"$ref": "#/$defs/detail_level"},
        "fields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/field_name"}
        },
        "binding": {"$ref": "#/$defs/query_binding"},
        "parent_observation": {
          "anyOf": [{"$ref": "#/$defs/parent_observation"}, {"type": "null"}]
        },
        "limits": {"$ref": "#/$defs/limits"},
        "cursor": {
          "anyOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]
        }
      },
      "required": [
        "query_kind",
        "entity_kind",
        "target",
        "filters",
        "projection",
        "detail_level",
        "fields",
        "binding",
        "parent_observation",
        "limits",
        "cursor"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "binding": {
                "properties": {"mode": {"const": "live"}}
              }
            }
          },
          "then": {
            "properties": {
              "parent_observation": {"$ref": "#/$defs/parent_observation"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding": {
                "properties": {"mode": {"const": "static"}}
              }
            }
          },
          "then": {
            "properties": {"parent_observation": {"type": "null"}}
          }
        }
      ]
    },
    "cursor_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query_kind": {"$ref": "#/$defs/query_kind"},
        "entity_kind": {"$ref": "#/$defs/entity_kind"},
        "target": {"$ref": "#/$defs/query_target"},
        "filters": {"$ref": "#/$defs/query_filters"},
        "projection": {"$ref": "#/$defs/projection"},
        "detail_level": {"$ref": "#/$defs/detail_level"},
        "fields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/field_name"}
        },
        "binding": {"$ref": "#/$defs/query_binding"},
        "parent_observation": {
          "anyOf": [{"$ref": "#/$defs/parent_observation"}, {"type": "null"}]
        },
        "limits": {"$ref": "#/$defs/limits"}
      },
      "required": [
        "query_kind",
        "entity_kind",
        "target",
        "filters",
        "projection",
        "detail_level",
        "fields",
        "binding",
        "parent_observation",
        "limits"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "content_manifest",
            "game_mod",
            "gateway_projection",
            "synthetic"
          ]
        },
        "ref": {
          "anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]
        }
      },
      "required": ["kind", "ref"]
    },
    "field": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"$ref": "#/$defs/field_name"},
            "kind": {
              "enum": [
                "boolean",
                "definition_ref",
                "integer",
                "instance_ref",
                "text",
                "text_list"
              ]
            },
            "availability": {
              "enum": [
                "available",
                "unavailable",
                "not_observable",
                "redacted",
                "unsupported",
                "missing"
              ]
            },
            "value": {
              "oneOf": [
                {"type": "boolean"},
                {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
                {"$ref": "#/$defs/text"},
                {
                  "type": "array",
                  "maxItems": 64,
                  "items": {"$ref": "#/$defs/text"}
                },
                {"$ref": "#/$defs/definition_ref"},
                {"$ref": "#/$defs/instance_ref"},
                {"type": "null"}
              ]
            },
            "unit": {
              "anyOf": [
                {"enum": ["none", "count", "gold", "hp", "block", "percent"]},
                {"type": "null"}
              ]
            },
            "source": {"$ref": "#/$defs/source"},
            "reason": {
              "anyOf": [{"$ref": "#/$defs/reason"}, {"type": "null"}]
            }
          },
          "required": [
            "name",
            "kind",
            "availability",
            "value",
            "unit",
            "source",
            "reason"
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "kind": {"const": "boolean"},
                "value": {
                  "anyOf": [{"type": "boolean"}, {"type": "null"}]
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "definition_ref"},
                "value": {
                  "anyOf": [{"$ref": "#/$defs/definition_ref"}, {"type": "null"}]
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "integer"},
                "value": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    {"type": "null"}
                  ]
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "instance_ref"},
                "value": {
                  "anyOf": [{"$ref": "#/$defs/instance_ref"}, {"type": "null"}]
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "text"},
                "value": {
                  "anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]
                }
              }
            },
            {
              "properties": {
                "kind": {"const": "text_list"},
                "value": {
                  "anyOf": [
                    {
                      "type": "array",
                      "maxItems": 64,
                      "items": {"$ref": "#/$defs/text"}
                    },
                    {"type": "null"}
                  ]
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "availability": {"const": "available"},
                "value": {"not": {"type": "null"}},
                "reason": {"type": "null"}
              }
            },
            {
              "properties": {
                "availability": {
                  "enum": [
                    "unavailable",
                    "not_observable",
                    "redacted",
                    "unsupported",
                    "missing"
                  ]
                },
                "value": {"type": "null"},
                "reason": {"$ref": "#/$defs/reason"}
              }
            }
          ]
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition_ref": {"$ref": "#/$defs/definition_ref"},
        "instance_ref": {
          "anyOf": [{"$ref": "#/$defs/instance_ref"}, {"type": "null"}]
        },
        "fields": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/field"}
        }
      },
      "required": ["definition_ref", "instance_ref", "fields"]
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "definition_ref",
            "instance_ref",
            "display_name",
            "namespaced_id"
          ]
        },
        "direction": {"enum": ["ascending", "descending"]},
        "algorithm": {
          "enum": ["identity_bytes", "unicode_scalar_values"]
        },
        "deterministic": {"const": true}
      },
      "required": ["key", "direction", "algorithm", "deterministic"]
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "item_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
        "payload_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
        "page_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
        "text_bytes": {"type": "integer", "minimum": 0, "maximum": 65536}
      },
      "required": ["item_count", "item_bytes", "payload_bytes", "page_bytes", "text_bytes"]
    },
    "page": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 128,
              "items": {"$ref": "#/$defs/item"}
            },
            "next_cursor": {
              "anyOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]
            },
            "cursor_binding": {
              "anyOf": [{"$ref": "#/$defs/cursor_binding"}, {"type": "null"}]
            },
            "final_page": {"type": "boolean"},
            "total_count_known": {"type": "boolean"},
            "total_count": {
              "anyOf": [
                {"type": "integer", "minimum": 0, "maximum": 1000000},
                {"type": "null"}
              ]
            },
            "coverage": {
              "enum": ["complete", "partial", "unavailable", "not_observable"]
            },
            "ordering": {"$ref": "#/$defs/ordering"},
            "limits": {"$ref": "#/$defs/limits"},
            "accounting": {"$ref": "#/$defs/accounting"}
          },
          "required": [
            "items",
            "next_cursor",
            "cursor_binding",
            "final_page",
            "total_count_known",
            "total_count",
            "coverage",
            "ordering",
            "limits",
            "accounting"
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "final_page": {"const": true},
                "next_cursor": {"type": "null"},
                "cursor_binding": {"type": "null"}
              }
            },
            {
              "properties": {
                "final_page": {"const": false},
                "next_cursor": {"$ref": "#/$defs/cursor"},
                "cursor_binding": {"$ref": "#/$defs/cursor_binding"}
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "total_count_known": {"const": true},
                "total_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            },
            {
              "properties": {
                "total_count_known": {"const": false},
                "total_count": {"type": "null"}
              }
            }
          ]
        }
      ]
    },
    "parent_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_ref": {"$ref": "#/$defs/instance_ref"},
        "snapshot_ref": {"$ref": "#/$defs/snapshot_ref"},
        "state_generation": {"$ref": "#/$defs/safe_integer"}
      },
      "required": ["instance_ref", "snapshot_ref", "state_generation"]
    },
    "result": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {"$ref": "#/$defs/page"},
            "result_generation": {
              "anyOf": [{"$ref": "#/$defs/safe_integer"}, {"type": "null"}]
            },
            "parent_observation": {
              "anyOf": [{"$ref": "#/$defs/parent_observation"}, {"type": "null"}]
            },
            "read_only": {"const": true}
          },
          "required": [
            "page",
            "result_generation",
            "parent_observation",
            "read_only"
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "result_generation": {"type": "null"},
                "parent_observation": {"type": "null"}
              }
            },
            {
              "properties": {
                "result_generation": {"$ref": "#/$defs/safe_integer"},
                "parent_observation": {"$ref": "#/$defs/parent_observation"}
              }
            }
          ]
        }
      ]
    },
    "snapshot_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports_live": {"const": true},
        "lifetime_generations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_retained_snapshots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "expiry_behavior": {"const": "reject_stale_snapshot"},
        "invalidated_by": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "restore",
              "restart",
              "profile_change",
              "content_change",
              "run_change",
              "epoch_change"
            ]
          }
        }
      },
      "required": [
        "supports_live",
        "lifetime_generations",
        "max_retained_snapshots",
        "expiry_behavior",
        "invalidated_by"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"const": "game-information-query-v1"},
        "query_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/query_kind"}
        },
        "entity_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entity_kind"}
        },
        "projections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/projection"}
        },
        "detail_levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/detail_level"}
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/field_name"}
        },
        "limits": {"$ref": "#/$defs/limits"},
        "max_message_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "max_cursor_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "snapshot_policy": {"$ref": "#/$defs/snapshot_policy"}
      },
      "required": [
        "profile",
        "query_kinds",
        "entity_kinds",
        "projections",
        "detail_levels",
        "fields",
        "limits",
        "max_message_bytes",
        "max_cursor_bytes",
        "snapshot_policy"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unknown_kind",
            "unknown_id",
            "ambiguous_id",
            "unsupported_filter",
            "unsupported_projection",
            "unsupported_version",
            "denied_scope",
            "stale_snapshot",
            "stale_cursor",
            "result_limit_exceeded",
            "missing_capability",
            "unsupported_field",
            "invalid_identity",
            "invalid_bounds",
            "mixed_generation",
            "malformed",
            "read_only_violation"
          ]
        },
        "field": {
          "anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]
        },
        "reason": {
          "anyOf": [{"$ref": "#/$defs/reason"}, {"type": "null"}]
        },
        "retryable": {"type": "boolean"}
      },
      "required": ["code", "field", "reason", "retryable"]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {"const": "game-information-query-v1"},
        "schema_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "correlation_id": {"$ref": "#/$defs/identity"},
        "kind": {
          "enum": [
            "query_request",
            "query_response",
            "capabilities_response",
            "error_response"
          ]
        },
        "query": {
          "anyOf": [{"$ref": "#/$defs/query"}, {"type": "null"}]
