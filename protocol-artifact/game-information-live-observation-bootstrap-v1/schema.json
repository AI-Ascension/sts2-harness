{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-game-information-live-observation-bootstrap-v1",
  "title": "STS2 game-information live-observation bootstrap contract v1",
  "description": "Bounded, read-only negotiated bootstrap for an entity-scoped game-information query-v1 live snapshot.",
  "oneOf": [
    {"$ref": "#/$defs/bootstrap_request"},
    {"$ref": "#/$defs/bootstrap_response"},
    {"$ref": "#/$defs/error_response"}
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entity_kind": {
      "enum": [
        "card",
        "character",
        "enemy",
        "event",
        "map_node",
        "potion",
        "power",
        "relic",
        "room",
        "status"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "const": "sts2-protocol/game-information-live-observation-bootstrap-v1"
        },
        "source": {
          "const": "schemas/game-information-live-observation-bootstrap-v1.schema.json"
        },
        "generator": {"const": "hand-authored"}
      },
      "required": ["artifact", "source", "generator"]
    },
    "owner_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native_snapshot_owner": {"const": "sts2-game-mod"},
        "content_manifest_owner": {"const": "sts2-game-mod"},
        "instance_fence_owner": {"const": "sts2-gateway"},
        "authority_epoch_owner": {"const": "sts2-harness"},
        "instance_ref_epoch_owner": {"const": "sts2-game-mod"},
        "transport_lease_epoch_role": {"const": "fence_only"}
      },
      "required": [
        "native_snapshot_owner",
        "content_manifest_owner",
        "instance_fence_owner",
        "authority_epoch_owner",
        "instance_ref_epoch_owner",
        "transport_lease_epoch_role"
      ]
    },
    "definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_manifest_id": {"$ref": "#/$defs/identity"},
        "entity_kind": {"$ref": "#/$defs/entity_kind"},
        "namespaced_id": {"$ref": "#/$defs/identity"},
        "variant": {
          "anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]
        }
      },
      "required": [
        "content_manifest_id",
        "entity_kind",
        "namespaced_id",
        "variant"
      ]
    },
    "instance_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_id": {"$ref": "#/$defs/identity"},
        "run_id": {"$ref": "#/$defs/identity"},
        "epoch": {"$ref": "#/$defs/safe_integer"},
        "entity_kind": {"$ref": "#/$defs/entity_kind"},
        "entity_id": {"$ref": "#/$defs/identity"}
      },
      "required": [
        "instance_id",
        "run_id",
        "epoch",
        "entity_kind",
        "entity_id"
      ]
    },
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/identity"},
        "instance_ref": {"$ref": "#/$defs/instance_ref"},
        "state_generation": {"$ref": "#/$defs/safe_integer"}
      },
      "required": ["snapshot_id", "instance_ref", "state_generation"]
    },
    "parent_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_ref": {"$ref": "#/$defs/instance_ref"},
        "snapshot_ref": {"$ref": "#/$defs/snapshot_ref"},
        "state_generation": {"$ref": "#/$defs/safe_integer"}
      },
      "required": ["instance_ref", "snapshot_ref", "state_generation"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_id": {"$ref": "#/$defs/identity"},
        "run_id": {"$ref": "#/$defs/identity"},
        "authority_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_manifest_id": {"$ref": "#/$defs/identity"},
        "locale": {"$ref": "#/$defs/locale"}
      },
      "required": [
        "instance_id",
        "run_id",
        "authority_epoch",
        "content_manifest_id",
        "locale"
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition_ref": {"$ref": "#/$defs/definition_ref"},
        "instance_ref": {
          "anyOf": [{"$ref": "#/$defs/instance_ref"}, {"type": "null"}]
        }
      },
      "required": ["definition_ref", "instance_ref"]
    },
    "visible_entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_ref": {"$ref": "#/$defs/instance_ref"},
        "snapshot_ref": {"$ref": "#/$defs/snapshot_ref"},
        "definition_ref": {
          "anyOf": [{"$ref": "#/$defs/definition_ref"}, {"type": "null"}]
        }
      },
      "required": ["instance_ref", "snapshot_ref", "definition_ref"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_visible_entities": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_item_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      },
      "required": ["max_visible_entities", "max_item_bytes", "max_message_bytes"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unsupported_version",
            "invalid_request",
            "invalid_bounds",
            "unavailable",
            "not_observable",
            "stale_snapshot",
            "invalid_binding",
            "ambiguous_entity"
          ]
        },
        "field": {
          "anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {"pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"}
        },
        "retryable": {"type": "boolean"}
      },
      "required": ["code", "field", "reason", "retryable"]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "game-information-live-observation-bootstrap-v1"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "correlation_id": {"$ref": "#/$defs/identity"},
        "kind": {
          "enum": ["bootstrap_request", "bootstrap_response", "error_response"]
        },
        "selector": {
          "anyOf": [{"$ref": "#/$defs/selector"}, {"type": "null"}]
        },
        "scope": {
          "anyOf": [{"$ref": "#/$defs/scope"}, {"type": "null"}]
        },
        "limits": {
          "anyOf": [{"$ref": "#/$defs/limits"}, {"type": "null"}]
        },
        "parent_observation": {
          "anyOf": [{"$ref": "#/$defs/parent_observation"}, {"type": "null"}]
        },
        "visible_entities": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/visible_entity"}
            },
            {"type": "null"}
          ]
        },
        "owner_provenance": {
          "anyOf": [{"$ref": "#/$defs/owner_provenance"}, {"type": "null"}]
        },
        "error": {
          "anyOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]
        }
      },
      "required": [
        "protocol_version",
        "schema_digest",
        "provenance",
        "correlation_id",
        "kind",
        "selector",
        "scope",
        "limits",
        "parent_observation",
        "visible_entities",
        "owner_provenance",
        "error"
      ]
    },
    "bootstrap_request": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "kind": {"const": "bootstrap_request"},
            "selector": {"$ref": "#/$defs/selector"},
            "scope": {"$ref": "#/$defs/scope"},
            "limits": {"$ref": "#/$defs/limits"},
            "parent_observation": {"type": "null"},
            "visible_entities": {"type": "null"},
            "owner_provenance": {"type": "null"},
            "error": {"type": "null"}
          }
        }
      ]
    },
    "bootstrap_response": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "kind": {"const": "bootstrap_response"},
            "selector": {"$ref": "#/$defs/selector"},
            "scope": {"$ref": "#/$defs/scope"},
            "limits": {"$ref": "#/$defs/limits"},
            "parent_observation": {"$ref": "#/$defs/parent_observation"},
            "visible_entities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/visible_entity"}
            },
            "owner_provenance": {"$ref": "#/$defs/owner_provenance"},
            "error": {"type": "null"}
          }
        }
      ]
    },
    "error_response": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "kind": {"const": "error_response"},
            "selector": {
              "anyOf": [{"$ref": "#/$defs/selector"}, {"type": "null"}]
            },
            "scope": {
              "anyOf": [{"$ref": "#/$defs/scope"}, {"type": "null"}]
            },
            "limits": {"type": "null"},
            "parent_observation": {"type": "null"},
            "visible_entities": {"type": "null"},
            "owner_provenance": {"type": "null"},
            "error": {"$ref": "#/$defs/error"}
          }
        }
      ]
    }
  }
}
