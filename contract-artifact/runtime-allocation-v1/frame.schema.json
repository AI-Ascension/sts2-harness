{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.invalid/schemas/watchdog-runtime-allocation-v1/frame.schema.json",
  "title": "watchdog runtime allocation v1 recovery authority",
  "description": "Closed recovery authority extension returned by the gateway allocation route. The context is immutable for the acquired lease and current_fence is the exact host-fence shape.",
  "$ref": "#/$defs/recovery_authority",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "positive_u53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$",
      "minLength": 20,
      "maxLength": 30
    },
    "authority_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "instance_id",
        "instance_incarnation",
        "boot_id",
        "authority_generation",
        "lease_id",
        "lease_epoch"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/uuid" },
        "instance_id": { "$ref": "#/$defs/uuid" },
        "instance_incarnation": { "$ref": "#/$defs/uuid_v4" },
        "boot_id": { "$ref": "#/$defs/uuid_v4" },
        "authority_generation": { "$ref": "#/$defs/positive_u53" },
        "lease_id": { "$ref": "#/$defs/uuid_v4" },
        "lease_epoch": { "$ref": "#/$defs/positive_u53" }
      }
    },
    "current_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_fence_id",
        "deployment_id",
        "instance_id",
        "instance_incarnation",
        "boot_id",
        "authority_generation",
        "fence_generation",
        "created_at"
      ],
      "properties": {
        "host_fence_id": { "$ref": "#/$defs/uuid_v4" },
        "deployment_id": { "$ref": "#/$defs/uuid" },
        "instance_id": { "$ref": "#/$defs/uuid" },
        "instance_incarnation": { "$ref": "#/$defs/uuid_v4" },
        "boot_id": { "$ref": "#/$defs/uuid_v4" },
        "authority_generation": { "$ref": "#/$defs/positive_u53" },
        "fence_generation": { "$ref": "#/$defs/positive_u53" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "recovery_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_digest", "context", "current_fence"],
      "properties": {
        "contract": { "const": "watchdog-runtime-allocation-v1" },
        "schema_digest": { "$ref": "#/$defs/sha256" },
        "context": { "$ref": "#/$defs/authority_context" },
        "current_fence": { "$ref": "#/$defs/current_fence" }
      }
    }
  }
}
