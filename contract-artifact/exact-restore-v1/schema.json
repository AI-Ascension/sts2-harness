{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.invalid/schemas/sts2-exact-restore-v1/frame.schema.json",
  "title": "sts2-exact-restore-v1 closed request and response frames",
  "oneOf": [
    {"$ref": "#/$defs/begin_request"},
    {"$ref": "#/$defs/chunk_request"},
    {"$ref": "#/$defs/finish_request"},
    {"$ref": "#/$defs/commit_request"},
    {"$ref": "#/$defs/lookup_request"},
    {"$ref": "#/$defs/begin_response"},
    {"$ref": "#/$defs/chunk_response"},
    {"$ref": "#/$defs/finish_response"},
    {"$ref": "#/$defs/commit_response"},
    {"$ref": "#/$defs/lookup_response"},
    {"$ref": "#/$defs/error_response"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bare_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "counter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "owner": {
      "type": "object",
      "properties": {
        "deployment_id": {"$ref": "#/$defs/uuid"},
        "instance_id": {"$ref": "#/$defs/uuid"},
        "instance_incarnation": {"$ref": "#/$defs/uuid"},
        "boot_id": {"$ref": "#/$defs/uuid"},
        "authority_generation": {"$ref": "#/$defs/counter"},
        "host_fence_id": {"$ref": "#/$defs/uuid"},
        "host_fence_generation": {"$ref": "#/$defs/counter"},
        "lease_id": {"$ref": "#/$defs/uuid"},
        "lease_epoch": {"$ref": "#/$defs/counter"},
        "session_id": {"$ref": "#/$defs/identity"},
        "lease_expires_at_millis": {"$ref": "#/$defs/counter"}
      },
      "required": [
        "deployment_id",
        "instance_id",
        "instance_incarnation",
        "boot_id",
        "authority_generation",
        "host_fence_id",
        "host_fence_generation",
        "lease_id",
        "lease_epoch",
        "session_id",
        "lease_expires_at_millis"
      ],
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "branch": {
      "type": "object",
      "properties": {
        "experiment_id": {"$ref": "#/$defs/identity"},
        "branch_id": {"$ref": "#/$defs/identity"},
        "metadata_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "run_id": {"$ref": "#/$defs/identity"},
        "episode_id": {"$ref": "#/$defs/identity"},
        "trajectory_id": {"$ref": "#/$defs/identity"}
      },
      "required": [
        "experiment_id",
        "branch_id",
        "metadata_revision",
        "run_id",
        "episode_id",
        "trajectory_id"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "phase": {"type": "string", "minLength": 1, "maxLength": 128},
        "game_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["kind", "phase"],
      "additionalProperties": false
    },
    "artifact_reference": {
      "type": "object",
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"$ref": "#/$defs/size"},
        "codec": {"type": "string", "minLength": 1}
      },
      "required": ["role", "digest", "size_bytes", "codec"],
      "additionalProperties": false
    },
    "request_base": {
      "type": "object",
      "properties": {
        "contract": {"const": "sts2-exact-restore-v1"},
        "schema_digest": {"$ref": "#/$defs/bare_sha256"},
        "message_id": {"$ref": "#/$defs/uuid_v4"},
        "correlation_id": {"$ref": "#/$defs/uuid_v4"}
      },
      "required": ["contract", "schema_digest", "message_id", "correlation_id"]
    },
    "response_base": {
      "type": "object",
      "properties": {
        "contract": {"const": "sts2-exact-restore-v1"},
        "schema_digest": {"$ref": "#/$defs/bare_sha256"},
        "message_id": {"$ref": "#/$defs/uuid_v4"},
        "correlation_id": {"$ref": "#/$defs/uuid_v4"}
      },
      "required": ["contract", "schema_digest", "message_id", "correlation_id"]
    },
    "request": {
      "allOf": [
        {"$ref": "#/$defs/request_base"},
        {
          "type": "object",
          "properties": {
            "kind": {"type": "string"},
            "payload": {"type": "object"}
          },
          "required": ["kind", "payload"]
        }
      ],
      "unevaluatedProperties": false
    },
    "response": {
      "allOf": [
        {"$ref": "#/$defs/response_base"},
        {
          "type": "object",
          "properties": {
            "kind": {"type": "string"},
            "payload": {"type": "object"}
          },
          "required": ["kind", "payload"]
        }
      ],
      "unevaluatedProperties": false
    },
    "begin_payload": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "expected_owner": {"$ref": "#/$defs/owner"},
        "branch": {"$ref": "#/$defs/branch"},
        "checkpoint_id": {
          "type": "string",
          "pattern": "^asc-checkpoint:v1:sha256:[0-9a-f]{64}$"
        },
        "exact_state_digest": {
          "type": "string",
          "pattern": "^asc-state:v1:sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {"$ref": "#/$defs/sha256"},
        "manifest_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "closure_digest": {"$ref": "#/$defs/sha256"},
        "compatibility_digest": {"$ref": "#/$defs/sha256"},
        "coverage_contract_digest": {"$ref": "#/$defs/sha256"},
        "boundary": {"$ref": "#/$defs/boundary"},
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/artifact_reference"}
        },
        "artifact_reference_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "distinct_blob_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "aggregate_closure_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      },
      "required": [
        "operation_id",
        "expected_owner",
        "branch",
        "checkpoint_id",
        "exact_state_digest",
        "manifest_digest",
        "manifest_size_bytes",
        "closure_digest",
        "compatibility_digest",
        "coverage_contract_digest",
        "boundary",
        "artifacts",
        "artifact_reference_count",
        "distinct_blob_count",
        "aggregate_closure_bytes"
      ],
      "additionalProperties": false
    },
    "chunk_payload": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "expected_owner": {"$ref": "#/$defs/owner"},
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "total_bytes": {"$ref": "#/$defs/size"},
        "chunk_digest": {"$ref": "#/$defs/sha256"},
        "data_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10924,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "operation_id",
        "expected_owner",
        "artifact_digest",
        "offset",
        "total_bytes",
        "chunk_digest",
        "data_base64"
      ],
      "additionalProperties": false
    },
    "phase_payload": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "expected_owner": {"$ref": "#/$defs/owner"}
      },
      "required": ["operation_id", "expected_owner"],
      "additionalProperties": false
    },
    "finish_payload": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "expected_owner": {"$ref": "#/$defs/owner"},
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "total_bytes": {"$ref": "#/$defs/size"}
      },
      "required": ["operation_id", "expected_owner", "artifact_digest", "total_bytes"],
      "additionalProperties": false
    },
    "commit_payload": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "expected_owner": {"$ref": "#/$defs/owner"},
        "branch": {"$ref": "#/$defs/branch"},
        "checkpoint_id": {
          "type": "string",
          "pattern": "^asc-checkpoint:v1:sha256:[0-9a-f]{64}$"
        },
        "closure_digest": {"$ref": "#/$defs/sha256"},
        "exact_state_digest": {
          "type": "string",
          "pattern": "^asc-state:v1:sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "operation_id",
        "expected_owner",
        "branch",
        "checkpoint_id",
        "closure_digest",
        "exact_state_digest",
        "manifest_digest"
      ],
      "additionalProperties": false
    },
    "request_payload": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "expected_owner": {"$ref": "#/$defs/owner"},
        "artifact_digest": {"$ref": "#/$defs/sha256"}
      },
      "required": ["operation_id", "expected_owner"],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "branch": {"$ref": "#/$defs/branch"},
        "destination_owner": {"$ref": "#/$defs/owner"},
        "checkpoint_id": {
          "type": "string",
          "pattern": "^asc-checkpoint:v1:sha256:[0-9a-f]{64}$"
        },
        "exact_state_digest": {
          "type": "string",
          "pattern": "^asc-state:v1:sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {"$ref": "#/$defs/sha256"},
        "closure_digest": {"$ref": "#/$defs/sha256"},
        "compatibility_digest": {"$ref": "#/$defs/sha256"},
        "coverage_contract_digest": {"$ref": "#/$defs/sha256"},
        "aggregate_closure_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "artifact_reference_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "distinct_blob_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "boundary": {"$ref": "#/$defs/boundary"},
        "recaptured_exact_state_digest": {
          "type": "string",
          "pattern": "^asc-state:v1:sha256:[0-9a-f]{64}$"
        },
        "receipt_digest": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "operation_id",
        "branch",
        "destination_owner",
        "checkpoint_id",
        "exact_state_digest",
        "manifest_digest",
        "closure_digest",
        "compatibility_digest",
        "coverage_contract_digest",
        "aggregate_closure_bytes",
        "artifact_reference_count",
        "distinct_blob_count",
        "boundary",
        "recaptured_exact_state_digest",
        "receipt_digest"
      ],
      "additionalProperties": false
    },
    "begin_request": {
      "allOf": [
        {"$ref": "#/$defs/request"},
        {
          "properties": {
            "kind": {"const": "exact_restore_begin_request"},
            "payload": {"$ref": "#/$defs/begin_payload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "chunk_request": {
      "allOf": [
        {"$ref": "#/$defs/request"},
        {
          "properties": {
            "kind": {"const": "exact_restore_chunk_request"},
            "payload": {"$ref": "#/$defs/chunk_payload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "finish_request": {
      "allOf": [
        {"$ref": "#/$defs/request"},
        {
          "properties": {
            "kind": {"const": "exact_restore_finish_blob_request"},
            "payload": {"$ref": "#/$defs/finish_payload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "commit_request": {
      "allOf": [
        {"$ref": "#/$defs/request"},
        {
          "properties": {
            "kind": {"const": "exact_restore_commit_request"},
            "payload": {"$ref": "#/$defs/commit_payload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "lookup_request": {
      "allOf": [
        {"$ref": "#/$defs/request"},
        {
          "properties": {
            "kind": {"const": "exact_restore_lookup_request"},
            "payload": {"$ref": "#/$defs/request_payload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "response_payload_base": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "result": {"type": "string"},
        "state": {
          "enum": [
            "STAGING",
            "CLOSURE_VERIFIED",
            "COMMIT_INTENT",
            "UNKNOWN",
            "RESTORE_VERIFIED",
            "NOT_FOUND"
          ]
        },
        "expected_owner": {"$ref": "#/$defs/owner"},
        "request_digest": {"$ref": "#/$defs/sha256"}
      },
      "required": ["operation_id", "result", "state", "expected_owner", "request_digest"]
    },
    "operation_state": {
      "enum": [
        "STAGING",
        "CLOSURE_VERIFIED",
        "COMMIT_INTENT",
        "UNKNOWN",
        "RESTORE_VERIFIED",
        "NOT_FOUND"
      ]
    },
    "existing_operation_state": {
      "enum": [
        "STAGING",
        "CLOSURE_VERIFIED",
        "COMMIT_INTENT",
        "UNKNOWN",
        "RESTORE_VERIFIED"
      ]
    },
    "receipt_optional_for_state": {
      "oneOf": [
        {
          "properties": {"state": {"const": "RESTORE_VERIFIED"}},
          "required": ["receipt"]
        },
        {
          "properties": {"state": {"enum": [
            "STAGING",
            "CLOSURE_VERIFIED",
            "COMMIT_INTENT",
            "UNKNOWN",
            "NOT_FOUND"
          ]}},
          "not": {"required": ["receipt"]}
        }
      ]
    },
    "begin_response_payload": {
      "allOf": [
        {"$ref": "#/$defs/response_payload_base"},
        {
          "type": "object",
          "properties": {
            "result": {"enum": ["CREATED", "EXISTING"]},
            "state": {"$ref": "#/$defs/operation_state"},
            "receipt": {"$ref": "#/$defs/receipt"}
          },
          "oneOf": [
            {
              "properties": {
                "result": {"const": "CREATED"},
                "state": {"const": "STAGING"}
              },
              "not": {"required": ["receipt"]}
            },
            {
              "properties": {
                "result": {"const": "EXISTING"},
                "state": {"$ref": "#/$defs/existing_operation_state"}
              }
            }
          ],
          "allOf": [{"$ref": "#/$defs/receipt_optional_for_state"}]
        }
      ],
      "unevaluatedProperties": false
    },
    "chunk_response_payload": {
      "allOf": [
        {"$ref": "#/$defs/response_payload_base"},
        {
          "type": "object",
          "properties": {
            "result": {"const": "CHUNK_ACCEPTED"},
            "state": {"const": "STAGING"},
            "artifact_digest": {"$ref": "#/$defs/sha256"},
            "next_offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777216
            }
          },
          "required": ["artifact_digest", "next_offset"]
        }
      ],
      "unevaluatedProperties": false
    },
    "finish_response_payload": {
      "allOf": [
        {"$ref": "#/$defs/response_payload_base"},
        {
          "type": "object",
          "properties": {
            "result": {"const": "BLOB_VERIFIED"},
            "state": {"enum": ["STAGING", "CLOSURE_VERIFIED"]},
            "artifact_digest": {"$ref": "#/$defs/sha256"},
            "total_bytes": {"$ref": "#/$defs/size"},
            "closure_state": {"enum": ["STAGING", "CLOSURE_VERIFIED"]}
          },
          "required": ["artifact_digest", "total_bytes", "closure_state"],
          "oneOf": [
            {
              "properties": {
                "state": {"const": "STAGING"},
                "closure_state": {"const": "STAGING"}
              }
            },
            {
              "properties": {
                "state": {"const": "CLOSURE_VERIFIED"},
                "closure_state": {"const": "CLOSURE_VERIFIED"}
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "commit_response_payload": {
      "allOf": [
        {"$ref": "#/$defs/response_payload_base"},
        {
          "type": "object",
          "properties": {
            "result": {"enum": ["COMMIT_INTENT", "UNKNOWN", "RESTORE_VERIFIED"]},
            "state": {"enum": ["COMMIT_INTENT", "UNKNOWN", "RESTORE_VERIFIED"]},
            "receipt": {"$ref": "#/$defs/receipt"}
          },
          "oneOf": [
            {
              "properties": {
                "result": {"const": "COMMIT_INTENT"},
                "state": {"const": "COMMIT_INTENT"}
              },
              "not": {"required": ["receipt"]}
            },
            {
              "properties": {
                "result": {"const": "UNKNOWN"},
                "state": {"const": "UNKNOWN"}
              },
              "not": {"required": ["receipt"]}
            },
            {
              "properties": {
                "result": {"const": "RESTORE_VERIFIED"},
                "state": {"const": "RESTORE_VERIFIED"}
              },
              "required": ["receipt"]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "lookup_response_payload": {
      "allOf": [
        {"$ref": "#/$defs/response_payload_base"},
        {
          "type": "object",
          "properties": {
            "result": {"$ref": "#/$defs/operation_state"},
            "state": {"$ref": "#/$defs/operation_state"},
            "artifact_digest": {"$ref": "#/$defs/sha256"},
            "total_bytes": {"$ref": "#/$defs/size"},
            "next_offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777216
            },
            "verified": {"type": "boolean"},
            "receipt": {"$ref": "#/$defs/receipt"}
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "properties": {
                    "result": {"const": "STAGING"},
                    "state": {"const": "STAGING"}
                  },
                  "not": {"required": ["receipt"]}
                },
                {
                  "properties": {
                    "result": {"const": "CLOSURE_VERIFIED"},
                    "state": {"const": "CLOSURE_VERIFIED"}
                  },
                  "not": {"required": ["receipt"]}
                },
                {
                  "properties": {
                    "result": {"const": "COMMIT_INTENT"},
                    "state": {"const": "COMMIT_INTENT"}
                  },
                  "not": {"required": ["receipt"]}
                },
                {
                  "properties": {
                    "result": {"const": "UNKNOWN"},
                    "state": {"const": "UNKNOWN"}
                  },
                  "not": {"required": ["receipt"]}
                },
                {
                  "properties": {
                    "result": {"const": "RESTORE_VERIFIED"},
                    "state": {"const": "RESTORE_VERIFIED"}
                  },
                  "required": ["receipt"]
                },
                {
                  "properties": {
                    "result": {"const": "NOT_FOUND"},
                    "state": {"const": "NOT_FOUND"}
                  },
                  "not": {
                    "anyOf": [
                      {"required": ["receipt"]},
                      {"required": ["artifact_digest"]},
                      {"required": ["total_bytes"]},
                      {"required": ["next_offset"]},
                      {"required": ["verified"]}
                    ]
                  }
                }
              ]
            },
            {
              "oneOf": [
                {
                  "required": [
                    "artifact_digest",
                    "total_bytes",
                    "next_offset",
                    "verified"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {"required": ["artifact_digest"]},
                      {"required": ["total_bytes"]},
                      {"required": ["next_offset"]},
                      {"required": ["verified"]}
                    ]
                  }
                }
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "error_response_payload": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid_v4"},
        "expected_owner": {"$ref": "#/$defs/owner"},
        "request_digest": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["REJECTED", "STALE_OWNER", "UNAVAILABLE"]},
        "error_code": {
          "enum": [
            "invalid_frame",
            "unsupported_closure",
            "capacity_full",
            "no_restore_adapter",
            "owner_mismatch",
            "owner_expired",
            "operation_conflict",
            "invalid_phase",
            "chunk_conflict",
            "digest_mismatch",
            "unknown_artifact",
            "native_unavailable",
            "route_unavailable",
            "restore_refused"
          ]
        },
        "host_effect": {"enum": ["not_started", "may_have_started"]}
      },
      "required": [
        "operation_id",
        "expected_owner",
        "request_digest",
        "outcome",
        "error_code",
        "host_effect"
      ],
      "oneOf": [
        {
          "properties": {
            "outcome": {"enum": ["REJECTED", "STALE_OWNER"]},
            "host_effect": {"const": "not_started"}
          }
        },
        {
          "properties": {"outcome": {"const": "UNAVAILABLE"}}
        }
      ],
      "additionalProperties": false
    },
    "begin_response": {
      "allOf": [
        {"$ref": "#/$defs/response"},
        {
          "properties": {
            "kind": {"const": "exact_restore_begin_response"},
            "payload": {"$ref": "#/$defs/begin_response_payload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "chunk_response": {
      "allOf": [
        {"$ref": "#/$defs/response"},
        {
          "properties": {
            "kind": {"const": "exact_restore_chunk_response"},
            "payload": {"$ref": "#/$defs/chunk_response_payload"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "finish_response": {
      "allOf": [
        {"$ref": "#/$defs/response"},
