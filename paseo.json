{
  "worktree": {
    "setup": [
      "cargo fetch --locked"
    ],
    "teardown": "echo \"Setup starts no persistent services; Paseo handles worktree removal.\""
  },
  "scripts": {
    "diff-check": {
      "command": "git diff --check"
    },
    "test": {
      "command": "cargo test --locked --workspace"
    },
    "format-check": {
      "command": "cargo fmt --all --check"
    }
  }
}
