{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-seeded-run-v1",
  "title": "STS2 explicit seeded-run launch contract",
  "description": "A bounded, fenced launch operation for a caller-selected seed. Admission is distinct from authoritative host settlement; selected_context binds native mode, character, ordered acts, profile baseline, save policy, and compatibility.",
  "oneOf": [
    {
      "$ref": "#/$defs/start_request"
    },
    {
      "$ref": "#/$defs/start_response"
    },
    {
      "$ref": "#/$defs/reconcile_request"
    },
    {
      "$ref": "#/$defs/reconcile_response"
    }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "source",
        "generator"
      ],
      "properties": {
        "artifact": {
          "const": "sts2-protocol/seeded-run-v1"
        },
        "source": {
          "const": "schemas/seeded-run-v1.schema.json"
        },
        "generator": {
          "const": "hand-authored"
        }
      }
    },
    "mode": {
      "enum": [
        "seeded_training",
        "seeded_replay",
        "diagnostic"
      ]
    },
    "status": {
      "enum": [
        "accepted",
        "settled",
        "rejected",
        "unknown",
        "cancelled"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_started",
        "host_ready",
        "generation",
        "canonical_seed",
        "selected_context_digest",
        "phase_before",
        "phase_after",
        "compatibility_identity"
      ],
      "properties": {
        "run_started": {
          "type": "boolean"
        },
        "host_ready": {
          "type": "boolean"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canonical_seed": {
          "$ref": "#/$defs/seed"
        },
        "selected_context_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase_before": {
          "$ref": "#/$defs/identity"
        },
        "phase_after": {
          "$ref": "#/$defs/identity"
        },
        "compatibility_identity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "effect_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "generation",
        "canonical_seed"
      ],
      "properties": {
        "kind": {
          "const": "run_started"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canonical_seed": {
          "$ref": "#/$defs/seed"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "protocol_version",
        "schema_digest",
        "provenance",
        "correlation_id",
        "instance_id",
        "session_id",
        "lease_id",
        "lease_epoch",
        "generation"
      ],
      "properties": {
        "protocol_version": {
          "const": "seeded-run-v1"
        },
        "schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "correlation_id": {
          "$ref": "#/$defs/identity"
        },
        "instance_id": {
          "$ref": "#/$defs/identity"
        },
        "session_id": {
          "$ref": "#/$defs/identity"
        },
        "lease_id": {
          "$ref": "#/$defs/identity"
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "message_fields": {
      "type": "object",
      "required": [
        "kind",
        "operation_id",
        "requested_seed",
        "run_mode",
        "context_digest",
        "selected_context",
        "status",
        "canonical_seed",
        "observation",
        "effect_witness",
        "error_code"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/identity"
        },
        "requested_seed": {
          "anyOf": [
            {
              "$ref": "#/$defs/seed"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/mode"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/status"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_seed": {
          "anyOf": [
            {
              "$ref": "#/$defs/seed"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_witness": {
          "anyOf": [
            {
              "$ref": "#/$defs/effect_witness"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/selected_context"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "start_request": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/message_fields"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "requested_seed",
            "run_mode",
            "selected_context"
          ],
          "properties": {
            "kind": {
              "const": "start_request"
            },
            "requested_seed": {
              "$ref": "#/$defs/seed"
            },
            "run_mode": {
              "$ref": "#/$defs/mode"
            },
            "status": {
              "type": "null"
            },
            "canonical_seed": {
              "type": "null"
            },
            "observation": {
              "type": "null"
            },
            "effect_witness": {
              "type": "null"
            },
            "error_code": {
              "type": "null"
            },
            "selected_context": {
              "$ref": "#/$defs/selected_context"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "reconcile_request": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/message_fields"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "operation_id"
          ],
          "properties": {
            "kind": {
              "const": "reconcile_request"
            },
            "requested_seed": {
              "type": "null"
            },
            "run_mode": {
              "type": "null"
            },
            "context_digest": {
              "type": "null"
            },
            "status": {
              "type": "null"
            },
            "canonical_seed": {
              "type": "null"
            },
            "observation": {
              "type": "null"
            },
            "effect_witness": {
              "type": "null"
            },
            "error_code": {
              "type": "null"
            },
            "selected_context": {
              "type": "null"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "response_common": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/message_fields"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "operation_id",
            "requested_seed",
            "run_mode",
            "status",
            "selected_context"
          ],
          "properties": {
            "requested_seed": {
              "$ref": "#/$defs/seed"
            },
            "run_mode": {
              "$ref": "#/$defs/mode"
            },
            "status": {
              "$ref": "#/$defs/status"
            },
            "selected_context": {
              "$ref": "#/$defs/selected_context"
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "canonical_seed": {
                "type": "null"
              },
              "observation": {
                "type": "null"
              },
              "effect_witness": {
                "type": "null"
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "settled"
              }
            }
          },
          "then": {
            "required": [
              "canonical_seed",
              "observation",
              "effect_witness"
            ],
            "properties": {
              "canonical_seed": {
                "$ref": "#/$defs/seed"
              },
              "observation": {
                "$ref": "#/$defs/observation"
              },
              "effect_witness": {
                "$ref": "#/$defs/effect_witness"
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "rejected",
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ],
            "properties": {
              "canonical_seed": {
                "type": "null"
              },
              "observation": {
                "type": "null"
              },
              "effect_witness": {
                "type": "null"
              },
              "error_code": {
                "$ref": "#/$defs/identity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ],
            "properties": {
              "canonical_seed": {
                "type": "null"
              },
              "observation": {
                "type": "null"
              },
              "effect_witness": {
                "type": "null"
              },
              "error_code": {
                "$ref": "#/$defs/identity"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "start_response": {
      "allOf": [
        {
          "$ref": "#/$defs/response_common"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "start_response"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "reconcile_response": {
      "allOf": [
        {
          "$ref": "#/$defs/response_common"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reconcile_response"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "identity_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "digest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "profile_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fresh",
            "existing"
          ]
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game",
        "mod"
      ],
      "properties": {
        "game": {
          "$ref": "#/$defs/identity_digest"
        },
        "mod": {
          "$ref": "#/$defs/identity_digest"
        }
      }
    },
    "selected_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "game_mode",
        "character",
        "ascension",
        "modifiers",
        "acts",
        "selection_policy",
        "profile_baseline",
        "save_policy",
        "compatibility",
        "context_digest"
      ],
      "properties": {
        "context_id": {
          "$ref": "#/$defs/identity"
        },
        "game_mode": {
          "const": "standard"
        },
        "character": {
          "const": "ironclad"
        },
        "ascension": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "modifiers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "acts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "selection_policy": {
          "$ref": "#/$defs/identity"
        },
        "profile_baseline": {
          "$ref": "#/$defs/profile_baseline"
        },
        "save_policy": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "context_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "Concrete native context. Modifiers are canonicalized as a sorted set; acts preserve native campaign sequence order."
    }
  }
}
